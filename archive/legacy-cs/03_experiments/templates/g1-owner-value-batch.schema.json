{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myis.g1-owner-value-batch.v1",
  "title": "myIS G1 Owner Value Batch V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_kind", "status", "executable", "gate",
    "gate_status", "authorization", "scientific_run", "dataset_access",
    "scientific_metric_count", "track", "phase", "task", "proposal_sha256",
    "generated_at_utc", "generator", "sources", "inventory_counts",
    "qrels_domain_distribution", "family_commitment_sha256", "evaluator",
    "field_protocol", "published_targets", "split", "validation",
    "unresolved_owner_decisions", "owner_decision_sha256", "mlflow"
  ],
  "properties": {
    "schema_version": {"const": "myis.g1-owner-value-batch.v1"},
    "document_kind": {"const": "g1_owner_value_batch"},
    "status": {"const": "proposal"},
    "executable": {"const": false},
    "gate": {"const": "G1"},
    "gate_status": {"const": "pending"},
    "authorization": {"const": "NOT_AUTHORIZED"},
    "scientific_run": {"const": false},
    "dataset_access": {"const": "owner_local_read_only"},
    "scientific_metric_count": {"const": 0},
    "track": {"const": "C"},
    "phase": {"const": "F1"},
    "task": {"const": "F1.1"},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "generator": {"type": "object"},
    "sources": {"type": "array", "minItems": 5, "maxItems": 5},
    "inventory_counts": {"type": "object"},
    "qrels_domain_distribution": {"type": "object"},
    "family_commitment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator": {"type": "object"},
    "field_protocol": {"type": "object"},
    "published_targets": {"type": "object"},
    "split": {"type": "object"},
    "validation": {"type": "object"},
    "unresolved_owner_decisions": {"type": "array", "minItems": 1},
    "owner_decision_sha256": {"type": ["string", "null"]},
    "mlflow": {"type": ["object", "null"]}
  }
}
