--- /dev/null
+++ b/tests/test_p2_measured_state.py
@@ -0,0 +1,103 @@
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import socket
+
+import pytest
+
+from myis_research.kernel.canonical import canonical_sha256
+from myis_research.p2.measured_state import (
+    ExclusiveWriterLease,
+    MeasuredRunJournal,
+    MeasuredStateError,
+    compare_and_swap_selection_counter,
+)
+
+
+def _request() -> dict:
+    return {
+        "schema_version": "myis.p2-measured-request.v1",
+        "request_id": "p2-measured-state-test",
+        "campaign_revision": "scope-autoindex-v1-p2-r1-primary-v1",
+    }
+
+
+def test_measured_journal_is_atomic_hash_bound_and_immutable(tmp_path: Path) -> None:
+    journal = MeasuredRunJournal(tmp_path / "run")
+    state = journal.initialize(
+        run_id="run-1",
+        request=_request(),
+        owner_paths={"cache_root": str(tmp_path / "cache"), "index_root": str(tmp_path / "index")},
+    )
+    assert journal.load() == state
+    state["stage"] = "base_train"
+    saved = journal.save(state)
+    assert journal.load()["stage"] == "base_train"
+    _, artifact_hash = journal.write_artifact("baseline-commitment.json", {"status": "committed"})
+    assert len(artifact_hash) == 64
+    with pytest.raises(Exception, match="overwrite"):
+        journal.write_artifact("baseline-commitment.json", {"status": "changed"})
+    verification = journal.verify()
+    assert verification["status"] == "passed"
+    assert verification["state_sha256"] == saved["state_sha256"]
+
+
+def test_exclusive_writer_rejects_concurrent_writer_and_closes_cleanly(tmp_path: Path) -> None:
+    run_root = tmp_path / "run"
+    with ExclusiveWriterLease(run_root, run_id="run-1", request_sha256="a" * 64) as lease:
+        lease.heartbeat()
+        with pytest.raises(MeasuredStateError, match="active writer"):
+            with ExclusiveWriterLease(run_root, run_id="run-1", request_sha256="a" * 64):
+                pass
+    assert not (run_root / "exclusive-writer.json").exists()
+    assert len(list((run_root / "lease-history").glob("lease-*.json"))) == 1
+
+
+def test_stale_lock_recovery_requires_independent_receipt(tmp_path: Path) -> None:
+    run_root = tmp_path / "run"
+    run_root.mkdir()
+    stale = {
+        "schema_version": "myis.p2-exclusive-writer-lease.v1",
+        "run_id": "run-1",
+        "request_sha256": "a" * 64,
+        "host": socket.gethostname(),
+        "pid": 99999999,
+        "process_start_time_utc": "2026-01-01T00:00:00Z",
+        "lease_heartbeat_utc": "2026-01-01T00:00:00Z",
+        "status": "active",
+    }
+    stale["lease_sha256"] = canonical_sha256(stale)
+    (run_root / "exclusive-writer.json").write_text(json.dumps(stale), encoding="utf-8")
+    with pytest.raises(MeasuredStateError, match="verified recovery"):
+        with ExclusiveWriterLease(run_root, run_id="run-1", request_sha256="a" * 64):
+            pass
+    verifier = tmp_path / "verifier.json"
+    verifier.write_text('{"status":"passed"}\n', encoding="utf-8")
+    with ExclusiveWriterLease(
+        run_root,
+        run_id="run-1",
+        request_sha256="a" * 64,
+        recover_stale=True,
+        verifier_receipt=verifier,
+    ):
+        pass
+    assert len(list((run_root / "recoveries").glob("stale-lease-*.json"))) == 1
+
+
+def test_global_selection_counter_is_compare_and_swap(tmp_path: Path) -> None:
+    first = compare_and_swap_selection_counter(
+        tmp_path,
+        request_id="request-1",
+        freeze_sha256="f" * 64,
+    )
+    assert first["selection_exposure_count"] == 1
+    with pytest.raises(MeasuredStateError, match="already consumed"):
+        compare_and_swap_selection_counter(
+            tmp_path,
+            request_id="request-2",
+            freeze_sha256="e" * 64,
+        )
+    assert not (tmp_path / "p2" / "global-selection-counter.lock").exists()
+

