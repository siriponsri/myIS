+def _compile_view_descriptors(
+    spec: ScopeSpec,
+    view_id: str,
+    view_kind: str,
+    source_fields: tuple[str, ...],
+    row: Mapping[str, Any],
+) -> list[dict[str, Any]]:
+    policy_root = spec.graph.get("unitization", {})
