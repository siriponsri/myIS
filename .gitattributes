# These imported provenance artifacts are byte-canonical CRLF files. Git must
# not normalize them because IMPORT_MANIFEST.csv binds their exact SHA-256.
01_evidence/literature/qa-provenance/BATCH_2A_ARTIFACT_VALIDATION.json -text whitespace=cr-at-eol
01_evidence/literature/qa-provenance/BATCH_2A_CSV_VALIDATION.json -text whitespace=cr-at-eol
01_evidence/literature/qa-provenance/BATCH_2A_INGESTION_CANDIDATES.csv -text whitespace=cr-at-eol

# Git Bash launchers must retain LF line endings on Windows.
06_frontend/mlflow/*.sh text eol=lf

# Canonical P1 JSON is hash-bound evidence. Preserve repository bytes on every
# platform so clean Windows checkouts cannot invalidate raw SHA-256 bindings.
control/assets/dapfam-p1-source.v1.json -text
campaigns/scope-autoindex-v1/requests/*.json -text
campaigns/scope-autoindex-v1/evidence/*.json -text
campaigns/scope-autoindex-v1/manifests/*.json -text
campaigns/scope-autoindex-v1/validation-reports/*.json -text
campaigns/scope-autoindex-v1/packages/*.json -text
outputs/audits/rigor/**/*.json -text
