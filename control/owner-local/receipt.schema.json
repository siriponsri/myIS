{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:owner-local-receipt:v1",
  "title": "Owner-local aggregate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_sha256", "decision_id", "scope_sha256", "aggregate_counts", "aggregate_hashes", "status", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "myis.owner-local-receipt.v1"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_id": {"type": "string", "enum": ["D1_START_CAMPAIGN", "D2_OPEN_FINAL"]},
    "scope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "aggregate_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "aggregate_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "status": {"const": "accepted"},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
