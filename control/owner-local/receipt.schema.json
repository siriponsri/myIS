{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:owner-local-receipt:v2",
  "title": "Owner-local aggregate metric receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_sha256", "request_id", "decision_id", "phase_id", "stage", "scope_sha256", "aggregate_counts", "aggregate_hashes", "metrics", "cost", "latency_seconds", "lineage_hashes", "historical_exposure", "status", "blockers", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "myis.owner-local-receipt.v2"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "request_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "enum": ["P1_CPU_EXECUTION_ENVELOPE", "D2_OPEN_FINAL", "D3_SUBMIT_RELEASE"]},
    "phase_id": {"type": "string"},
    "stage": {"type": "string"},
    "scope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "aggregate_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "aggregate_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value", "n", "scope", "split", "direction", "denominator", "evidence_role"], "properties": {"arm": {"enum": ["R0", "R0-W"]}, "name": {"const": "recall_at_100"}, "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "n": {"type": "integer", "minimum": 0}, "hits": {"type": "integer", "minimum": 0}, "retrieved_relevant": {"type": "integer", "minimum": 0}, "relevant_total": {"type": "integer", "minimum": 0}, "scope": {"enum": ["ALL", "IN", "OUT"]}, "split": {"type": "string", "minLength": 1}, "direction": {"const": "maximize"}, "denominator": {"enum": ["macro_mean_per_query_relevant_families", "queries_with_positive_family_relevance"]}, "evidence_role": {"type": "string", "minLength": 1}}}},
    "cost": {"type": "object", "additionalProperties": false, "required": ["currency", "value"], "properties": {"currency": {"const": "USD"}, "value": {"type": "number", "minimum": 0}}},
    "latency_seconds": {"type": "number", "minimum": 0},
    "lineage_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "historical_exposure": {"type": "object"},
    "status": {"enum": ["accepted", "blocked"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
