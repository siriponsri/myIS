{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:owner-local-request:v2",
  "title": "Owner-local P1 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "decision_id", "phase_id", "stage", "scope", "git_commit", "input_hashes"],
  "properties": {
    "schema_version": {"const": "myis.owner-local-request.v2"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "decision_id": {"type": "string", "enum": ["P1_CPU_EXECUTION_ENVELOPE", "D2_OPEN_FINAL", "D3_SUBMIT_RELEASE"]},
    "phase_id": {"type": "string", "enum": ["P1_CPU_BASELINE", "P3_FINAL", "P4_PUBLICATION"]},
    "stage": {"type": "string", "enum": ["train_selection", "final", "report"]},
    "scope": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "git_commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "input_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  }
}
