{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:observatory-environment:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "environment_lock_sha256", "dependency_lock_sha256", "evidence_class", "scientific_authority", "claim_boundary", "record_sha256"],
  "properties": {
    "schema_version": {"const": "myis.observatory-environment.v1"},
    "record_id": {"type": "string"}, "environment_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "dependency_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runtime": {"type": "string"}, "platform": {"type": "string"}, "summary": {"type": "string"},
    "evidence_class": {"type": "string"}, "scientific_authority": {"type": "boolean"}, "claim_boundary": {"type": "string"}, "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
