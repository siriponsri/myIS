{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:armindex-owner-data-bundle-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_id", "status", "bundle_root_pointer",
    "source_manifest_sha256", "train_rep_hdev_status", "selection_status",
    "selection_next_state", "final_status", "final_next_state", "a6_status",
    "a6_next_state", "selection_accesses", "final_accesses",
    "protected_payload_included", "measured_access", "source_contract_sha256",
    "full_corpus_row_count", "parent_split_sha256", "partition_counts",
    "rep_dev_count", "hdev_count", "membership_commitment_sha256",
    "forbidden_outputs", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "myis.armindex-owner-data-bundle-receipt.v1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "status": {"const": "PASS_OWNER_DATA_BUNDLE_PREPARED"},
    "bundle_root_pointer": {"type": "string", "pattern": "^[^/].*$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_split_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "membership_commitment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "train_rep_hdev_status": {"const": "PREPARED_HASH_BOUND"},
    "selection_status": {"const": "SEALED_PRE_MEASUREMENT"},
    "selection_next_state": {"const": "PENDING_PAIRED_VECTORS"},
    "final_status": {"const": "SEALED_PRE_D2"},
    "final_next_state": {"const": "PENDING_A5_D2"},
    "a6_status": {"const": "SOURCE_HASHED"},
    "a6_next_state": {"const": "PENDING_A5_FROZEN_WINNER"},
    "selection_accesses": {"const": 0},
    "final_accesses": {"const": 0},
    "protected_payload_included": {"const": false},
    "measured_access": {"const": false},
    "full_corpus_row_count": {"const": 45336},
    "rep_dev_count": {"const": 150},
    "hdev_count": {"const": 100},
    "partition_counts": {"const": {"train": 250, "selection": 125, "final": 872}},
    "forbidden_outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}
