{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-engineering-execution-contract.v16.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision_id", "status", "preserves", "frozen_file_sha256", "executor_sources", "support_sources", "required_adoption_bindings", "runtime_policy", "authorization", "counters", "contract_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-engineering-execution-contract.v16"},
    "revision_id": {"const": "a1.2-engineering-execution-v16"},
    "status": {"enum": ["PENDING_EXECUTOR_INTEGRATION", "READY_FOR_CLEAN_BUNDLE"]},
    "preserves": {"type": "object", "additionalProperties": false, "required": ["v11", "v12_r3", "v13", "v14", "v15"], "properties": {"v11": {"const": "unchanged_scientific_request"}, "v12_r3": {"const": "unchanged_adoption_inputs"}, "v13": {"const": "unchanged_publication_contract"}, "v14": {"const": "unchanged_dense_overflow_policy"}, "v15": {"const": "unchanged_scientific_workload_budget_caps_execution_identity_rebound"}}},
    "frozen_file_sha256": {"type": "object", "minProperties": 14, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "executor_sources": {"type": "object", "additionalProperties": false, "required": ["retrieval_executor", "execution_lifecycle"], "properties": {"retrieval_executor": {"$ref": "#/$defs/source"}, "execution_lifecycle": {"$ref": "#/$defs/source"}}},
    "support_sources": {"type": "object", "additionalProperties": false, "required": ["safe_return", "safe_return_builder", "raw_materializer_bridge", "watchdog", "input_manifest", "measured_runner", "remote_arm_worker", "distributed_launcher", "evaluator_promotion", "evaluation_manifest_builder", "evaluator_closeout"], "properties": {"safe_return": {"$ref": "#/$defs/source"}, "safe_return_builder": {"$ref": "#/$defs/source"}, "raw_materializer_bridge": {"$ref": "#/$defs/source"}, "watchdog": {"$ref": "#/$defs/source"}, "input_manifest": {"$ref": "#/$defs/source"}, "measured_runner": {"$ref": "#/$defs/source"}, "remote_arm_worker": {"$ref": "#/$defs/source"}, "distributed_launcher": {"$ref": "#/$defs/source"}, "evaluator_promotion": {"$ref": "#/$defs/source"}, "evaluation_manifest_builder": {"$ref": "#/$defs/source"}, "evaluator_closeout": {"$ref": "#/$defs/source"}}},
    "required_adoption_bindings": {"const": ["provider_identity", "all_fee_quote", "whole_workload_budget", "provider_management_authority", "watchdog_ttl", "ssh_identity", "runtime_identity", "scientific_request", "adoption_inputs", "transfer", "workload", "common_programs", "model_lockset", "protected_compiler", "image", "git_commit_tree_bundle", "evaluator", "split", "qrels_commitment", "token_map", "safe_return", "compiled_bindings_25_of_25", "physical_coverage_35", "promotion_policy"]},
    "runtime_policy": {"type": "object", "additionalProperties": false, "required": ["runtime_downloads_forbidden", "model_bytes_owner_local_only", "protected_payload_in_bundle", "safe_aggregate_export_required"], "properties": {"runtime_downloads_forbidden": {"const": true}, "model_bytes_owner_local_only": {"const": true}, "protected_payload_in_bundle": {"const": false}, "safe_aggregate_export_required": {"const": true}}},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["provider_admission_receipt_pass", "execution_adoption_receipt_pass", "measured_retrieval_allowed", "selection_allowed", "final_allowed", "paid_api_allowed"], "properties": {"provider_admission_receipt_pass": {"const": false}, "execution_adoption_receipt_pass": {"const": false}, "measured_retrieval_allowed": {"const": false}, "selection_allowed": {"const": false}, "final_allowed": {"const": false}, "paid_api_allowed": {"const": false}}},
    "counters": {"type": "object", "additionalProperties": false, "required": ["measured_runs", "selection_accesses", "final_accesses"], "properties": {"measured_runs": {"const": 0}, "selection_accesses": {"const": 0}, "final_accesses": {"const": 0}}},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(src/myis_research/armindex|scripts/a1_2_vast)/[A-Za-z0-9_./-]+\\.(py|ps1)$"}, "sha256": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]}}}
  }
}
