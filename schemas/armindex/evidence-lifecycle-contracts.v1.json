          "minimum": 0,
          "title": "Index Size Bytes",
          "type": "integer"
        },
        "latency_p50_ms": {
          "minimum": 0,
          "title": "Latency P50 Ms",
          "type": "number"
        },
        "latency_p95_ms": {
          "minimum": 0,
          "title": "Latency P95 Ms",
          "type": "number"
