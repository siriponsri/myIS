{
  "$defs": {
    "AggregateReceipt": {
      "additionalProperties": false,
      "properties": {
        "aggregate_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Aggregate Counts",
          "type": "object"
        },
        "aggregate_metric_sha256s": {
          "items": {
            "type": "string"
          },
          "title": "Aggregate Metric Sha256S",
          "type": "array"
        },
        "commercial_status": {
          "enum": [
            "commercial_capable",
            "research_non_commercial",
            "mixed",
            "not_applicable"
          ],
          "title": "Commercial Status",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "cost_receipt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Cost Receipt Sha256",
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "synthetic_fixture",
            "engineering",
            "aggregate_evidence",
            "contract_only"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "final_accesses": {
          "const": 0,
          "title": "Final Accesses",
          "type": "integer"
        },
        "measured_execution": {
          "const": false,
          "title": "Measured Execution",
          "type": "boolean"
        },
        "protected_data_accessed": {
          "const": false,
          "title": "Protected Data Accessed",
          "type": "boolean"
        },
        "receipt_id": {
          "minLength": 1,
          "title": "Receipt Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "run_manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Run Manifest Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "myis.armindex-aggregate-receipt.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_authority": {
          "title": "Scientific Authority",
          "type": "boolean"
        },
        "selection_accesses": {
          "const": 0,
          "title": "Selection Accesses",
          "type": "integer"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "evidence_class",
        "scientific_authority",
        "commercial_status",
        "protected_data_accessed",
        "contract_sha256",
        "schema_version",
        "receipt_id",
        "run_id",
        "run_manifest_sha256",
        "status",
        "aggregate_metric_sha256s",
        "aggregate_counts",
        "cost_receipt_sha256",
        "measured_execution",
        "selection_accesses",
        "final_accesses"
      ],
      "title": "AggregateReceipt",
      "type": "object"
    },
