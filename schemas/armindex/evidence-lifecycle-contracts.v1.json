          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "myis.armindex-cost-receipt.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_authority": {
          "title": "Scientific Authority",
          "type": "boolean"
        },
        "throughput_qps": {
          "minimum": 0,
          "title": "Throughput Qps",
          "type": "number"
        },
        "vram_bytes": {
          "minimum": 0,
          "title": "Vram Bytes",
          "type": "integer"
        }
