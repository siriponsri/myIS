        "ram_bytes": {
          "minimum": 0,
          "title": "Ram Bytes",
          "type": "integer"
        },
        "receipt_id": {
          "minLength": 1,
          "title": "Receipt Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "run_manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
