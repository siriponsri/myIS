{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-runtime-minimal-direct-base.v5.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "revision_id", "status", "evidence_class", "scientific_authority", "claim_boundary", "contract_sha256", "policy_sha256", "v3_receipt_sha256", "image_reference", "resolved_manifest_digest", "platform", "local_preparation_status", "model_snapshots", "cpu_model_load", "dense_gpu_parity", "qwen_measured_max_length", "gpu_memory_feasibility", "custom_local_docker_build", "launch_allowed", "adopted_for_execution", "real_counters", "resource_counters", "live_checks_pending", "removed_active_steps", "upload_artifacts", "next_authorized_action", "bindings", "receipt_sha256"],
