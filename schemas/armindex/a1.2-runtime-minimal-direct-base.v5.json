    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "v3_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "image_reference": {"const": "pytorch/pytorch:2.6.0-cuda11.8-cudnn9-runtime"},
    "resolved_manifest_digest": {"const": "sha256:2428b92ebbaeceba5572b98c18c8a94e43162bead6e88588ad54471147c58a20"},
    "platform": {"const": "linux/amd64"},
    "local_preparation_status": {"type": "string"},
    "model_snapshots": {"const": "runtime_minimal_frozen"},
    "cpu_model_load": {"const": "intentionally_skipped_due_host_memory"},
    "dense_gpu_parity": {"const": "pending_live_vast_preflight"},
    "qwen_measured_max_length": {"const": "pending_live_vast_preflight"},
    "gpu_memory_feasibility": {"const": "pending_live_vast_preflight"},
    "custom_local_docker_build": {"const": false},
    "launch_allowed": {"const": false},
    "adopted_for_execution": {"const": false},
    "real_counters": {"type": "object", "additionalProperties": {"const": 0}},
    "resource_counters": {"type": "object", "additionalProperties": {"const": 0}},
    "live_checks_pending": {"type": "array", "minItems": 10, "items": {"type": "string"}},
    "removed_active_steps": {"type": "array", "items": {"type": "string"}},
    "upload_artifacts": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "next_authorized_action": {"type": "string", "minLength": 20},
    "bindings": {"type": "array", "minItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["uri", "sha256"], "properties": {"uri": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
