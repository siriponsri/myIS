{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-owner-local-protected-compilation-input.v15.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_id", "claim_boundary", "artifacts", "models", "protected_index_manifest_directory", "pre_compilation_anchor", "compatibility_audits"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-owner-local-protected-compilation-input.v15"},
    "input_id": {"type": "string", "pattern": "^a1\\.2-v15-[a-z0-9-]+$"},
    "claim_boundary": {"type": "string", "minLength": 120},
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["corpus", "queries", "split", "evaluator", "ephemeral_token_map", "handoff_receipt", "protected_transfer_manifest"],
      "properties": {
        "corpus": {"$ref": "#/$defs/artifact"},
        "queries": {"$ref": "#/$defs/artifact"},
        "split": {"$ref": "#/$defs/artifact"},
        "evaluator": {"$ref": "#/$defs/artifact"},
        "ephemeral_token_map": {"$ref": "#/$defs/artifact"},
        "handoff_receipt": {"$ref": "#/$defs/artifact"},
        "protected_transfer_manifest": {"$ref": "#/$defs/artifact"}
      }
    },
    "models": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/model"}},
    "protected_index_manifest_directory": {"$ref": "#/$defs/relative_path"},
    "pre_compilation_anchor": {"$ref": "#/$defs/artifact"},
    "compatibility_audits": {
      "type": "object", "additionalProperties": false,
      "required": ["v14_contract", "inventory", "composition", "p02_repair", "split_decision"],
      "properties": {
        "v14_contract": {"$ref": "#/$defs/repo_binding"},
        "inventory": {"$ref": "#/$defs/repo_binding"},
        "composition": {"$ref": "#/$defs/repo_binding"},
        "p02_repair": {"$ref": "#/$defs/repo_binding"},
        "split_decision": {"$ref": "#/$defs/repo_binding"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relative_path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {"relative_path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "repo_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "file_sha256", "self_sha256"],
      "properties": {"uri": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}, "file_sha256": {"$ref": "#/$defs/hash"}, "self_sha256": {"$ref": "#/$defs/hash"}}
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["arm_id", "model_relative_path", "tokenizer_json_relative_path", "runtime_manifest_relative_path"],
      "properties": {
        "arm_id": {"enum": ["ARM-01", "ARM-02", "ARM-03", "ARM-04", "ARM-05"]},
        "model_relative_path": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "tokenizer_json_relative_path": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "runtime_manifest_relative_path": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]}
      }
    }
  }
}
