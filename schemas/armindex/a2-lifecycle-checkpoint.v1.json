{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:myis:armindex:a2-lifecycle-checkpoint:v1","type":"object","additionalProperties":false,"required":["schema_version","checkpoint_id","attempt_id","sequence","previous_checkpoint_sha256","status","completed_candidate_count","failed_candidate_count","resume_allowed","freeze_bindings","checkpoint_sha256"],"properties":{"schema_version":{"const":"myis.armindex-a2-lifecycle-checkpoint.v1"},"checkpoint_id":{"pattern":"^a2-[a-z0-9-]+-checkpoint-[0-9]{4}$"},"attempt_id":{"pattern":"^a2-[a-z0-9-]{7,63}$"},"sequence":{"type":"integer","minimum":1},"previous_checkpoint_sha256":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/hash"}]},"status":{"enum":["STAGED","RUNNING","PAUSED","FAILED_CLOSED","SAFE_RETURNED"]},"completed_candidate_count":{"type":"integer","minimum":0,"maximum":52},"failed_candidate_count":{"type":"integer","minimum":0,"maximum":52},"resume_allowed":{"type":"boolean"},"freeze_bindings":{"$ref":"#/$defs/freeze"},"checkpoint_sha256":{"$ref":"#/$defs/hash"}},"allOf":[{"if":{"properties":{"status":{"enum":["FAILED_CLOSED","SAFE_RETURNED"]}}},"then":{"properties":{"resume_allowed":{"const":false}}}}],"$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"freeze":{"type":"object","additionalProperties":false,"required":["manifest_sha256","freeze_receipt_sha256","lock_sha256"],"properties":{"manifest_sha256":{"$ref":"#/$defs/hash"},"freeze_receipt_sha256":{"$ref":"#/$defs/hash"},"lock_sha256":{"$ref":"#/$defs/hash"}}}}}
