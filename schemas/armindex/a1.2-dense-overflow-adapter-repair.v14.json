{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-dense-overflow-adapter-repair.v14.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "repair_id", "status", "owner_decision",
    "immutable_lineage", "raw_inventory", "implementation",
    "composition_semantics", "arm_postprocessing", "v9_adapter_lineage",
    "publication_method_disclosure", "requirements", "authorization",
    "contract_sha256"
  ],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-dense-overflow-adapter-repair.v14"},
    "repair_id": {"const": "a1.2-additive-dense-overflow-composition-v14"},
    "status": {"const": "FROZEN_ADDITIVE_PRE_MEASUREMENT_REPAIR"},
    "owner_decision": {"$ref": "#/$defs/owner_decision"},
    "immutable_lineage": {"$ref": "#/$defs/immutable_lineage"},
    "raw_inventory": {"$ref": "#/$defs/raw_inventory"},
    "implementation": {"$ref": "#/$defs/implementation"},
    "composition_semantics": {"$ref": "#/$defs/composition"},
    "arm_postprocessing": {"$ref": "#/$defs/arm_postprocessing"},
    "v9_adapter_lineage": {"$ref": "#/$defs/v9_lineage"},
    "publication_method_disclosure": {"$ref": "#/$defs/publication_disclosure"},
    "requirements": {"$ref": "#/$defs/requirements"},
    "authorization": {"$ref": "#/$defs/authorization"},
    "contract_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
