{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:a2-candidate-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "campaign_id", "phase_id", "task_id", "revision_id", "generation_attempt_id", "status", "seed", "design", "bindings", "candidate_count", "matched_candidate_count", "conditional_reserve_candidate_count", "candidate_ids_sha256", "scientific_payload_set_sha256", "batches", "candidates", "official_call_binding_count", "protected_data_accessed", "rep_dev_accessed_for_measurement", "measured_execution_performed", "gpu_work_performed", "provider_admission_performed", "provider_execution_adoption_performed", "manifest_sha256"],
  "properties": {
    "schema_version": {"type": "string", "const": "myis.armindex-a2-candidate-manifest.v1"},
    "manifest_id": {"type": "string", "const": "a2-five-arm-candidate-manifest-v1"},
    "campaign_id": {"type": "string", "const": "armindex-multiretriever-v2"},
    "phase_id": {"type": "string", "const": "A2_PER_ARM_AUTOINDEX"},
    "task_id": {"type": "string", "const": "OFFICIAL_CODEX_BRIDGE_AND_CANDIDATE_FREEZE"},
    "revision_id": {"type": "string", "const": "a2-five-arm-premeasurement-freeze-v1"},
    "generation_attempt_id": {"type": "string", "pattern": "^a2freeze-[0-9]{8}t[0-9]{6}z$"},
    "status": {"type": "string", "const": "frozen_before_measurement"},
    "seed": {"type": "integer", "const": 20260812},
    "design": {"$ref": "#/$defs/design"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "candidate_count": {"type": "integer", "const": 52},
    "matched_candidate_count": {"type": "integer", "const": 40},
    "conditional_reserve_candidate_count": {"type": "integer", "const": 12},
    "candidate_ids_sha256": {"$ref": "#/$defs/sha256"},
    "scientific_payload_set_sha256": {"$ref": "#/$defs/sha256"},
    "batches": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"$ref": "#/$defs/batch"}},
    "candidates": {"type": "array", "minItems": 52, "maxItems": 52, "items": {"$ref": "#/$defs/candidate"}},
    "official_call_binding_count": {"type": "integer", "const": 26},
    "protected_data_accessed": {"type": "boolean", "const": false},
    "rep_dev_accessed_for_measurement": {"type": "boolean", "const": false},
    "measured_execution_performed": {"type": "boolean", "const": false},
    "gpu_work_performed": {"type": "boolean", "const": false},
    "provider_admission_performed": {"type": "boolean", "const": false},
    "provider_execution_adoption_performed": {"type": "boolean", "const": false},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "armId": {"type": "string", "enum": ["ARM-01", "ARM-02", "ARM-03", "ARM-04", "ARM-05"]},
    "role": {"type": "string", "enum": ["exploit", "matched_ablation", "orthogonal", "diversity"]},
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arms", "primary_advancement_arms", "diagnostic_non_advancing_arms", "roles", "matched_batches_per_arm", "matched_candidates_per_arm", "conditional_reserve_candidates_per_primary_arm", "matched_candidate_count", "conditional_reserve_candidate_count", "candidate_count", "batch_count", "reserve_activation_predicate", "stable_id_pattern"],
      "properties": {
        "arms": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/armId"}},
        "primary_advancement_arms": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/armId"}},
        "diagnostic_non_advancing_arms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/armId"}},
        "roles": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/role"}},
        "matched_batches_per_arm": {"type": "integer", "const": 2},
        "matched_candidates_per_arm": {"type": "integer", "const": 8},
        "conditional_reserve_candidates_per_primary_arm": {"type": "integer", "const": 4},
        "matched_candidate_count": {"type": "integer", "const": 40},
        "conditional_reserve_candidate_count": {"type": "integer", "const": 12},
        "candidate_count": {"type": "integer", "const": 52},
        "batch_count": {"type": "integer", "const": 13},
        "reserve_activation_predicate": {"type": "string", "minLength": 20},
        "stable_id_pattern": {"type": "string", "minLength": 20}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_sha256", "a1_terminal_receipt_sha256", "promotion_receipt_sha256", "representation_schema_sha256", "evaluator_sha256", "primary_metric", "a1_summary_sha256", "a1_summary_file_sha256", "a1_terminal_file_sha256", "execution_envelope_sha256", "budget_profile_sha256", "execution_contract_sha256", "bridge_config_sha256", "compiler_sha256", "verifier_sha256", "manifest_schema_sha256", "freeze_receipt_schema_sha256", "freeze_lock_schema_sha256", "source_commit", "source_tree"],
      "properties": {
        "campaign_sha256": {"$ref": "#/$defs/sha256"},
        "a1_terminal_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "promotion_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "representation_schema_sha256": {"$ref": "#/$defs/sha256"},
        "evaluator_sha256": {"$ref": "#/$defs/sha256"},
        "primary_metric": {"type": "string", "const": "recall_at_100/out"},
        "a1_summary_sha256": {"$ref": "#/$defs/sha256"},
        "a1_summary_file_sha256": {"$ref": "#/$defs/sha256"},
        "a1_terminal_file_sha256": {"$ref": "#/$defs/sha256"},
        "execution_envelope_sha256": {"$ref": "#/$defs/sha256"},
        "budget_profile_sha256": {"$ref": "#/$defs/sha256"},
        "execution_contract_sha256": {"$ref": "#/$defs/sha256"},
        "bridge_config_sha256": {"$ref": "#/$defs/sha256"},
        "compiler_sha256": {"$ref": "#/$defs/sha256"},
        "verifier_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_schema_sha256": {"$ref": "#/$defs/sha256"},
        "freeze_receipt_schema_sha256": {"$ref": "#/$defs/sha256"},
        "freeze_lock_schema_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "source_tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "arm_id", "tier", "batch_index", "candidate_ids", "proposer_request_sha256", "proposer_event_sha256", "reviewer_request_sha256", "reviewer_event_sha256", "revision_round", "status", "batch_sha256", "proposer_identity_sha256", "reviewer_identity_sha256"],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "arm_id": {"$ref": "#/$defs/armId"},
        "tier": {"type": "string", "enum": ["matched", "conditional_reserve"]},
        "batch_index": {"type": "integer", "minimum": 1, "maximum": 3},
        "candidate_ids": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "pattern": "^a2-arm-[0-9]{2}-(matched|reserve)-b[1-3]-(exploit|matched-ablation|orthogonal|diversity)$"}},
        "proposer_request_sha256": {"$ref": "#/$defs/sha256"},
        "proposer_event_sha256": {"$ref": "#/$defs/sha256"},
        "reviewer_request_sha256": {"$ref": "#/$defs/sha256"},
        "reviewer_event_sha256": {"$ref": "#/$defs/sha256"},
        "revision_round": {"type": "integer", "minimum": 0, "maximum": 2},
        "status": {"type": "string", "const": "accepted_frozen_before_measurement"},
        "batch_sha256": {"$ref": "#/$defs/sha256"},
        "proposer_identity_sha256": {"$ref": "#/$defs/sha256"},
        "reviewer_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "arm_id", "tier", "batch_id", "batch_index", "role", "lifecycle", "advancement_eligible", "diagnostic_non_advancing", "hypothesis", "declared_axis", "program", "program_sha256", "compiled_sha256", "compile_sha256s", "scientific_payload_sha256", "matched_ablation_id", "proposer_request_sha256", "proposer_event_sha256", "reviewer_request_sha256", "reviewer_event_sha256", "review_verdict", "verifier_status", "synthetic_source_sha256", "omitted_unit_count", "truncated_span_count"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^a2-arm-[0-9]{2}-(matched|reserve)-b[1-3]-(exploit|matched-ablation|orthogonal|diversity)$"},
        "arm_id": {"$ref": "#/$defs/armId"},
        "tier": {"type": "string", "enum": ["matched", "conditional_reserve"]},
        "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "batch_index": {"type": "integer", "minimum": 1, "maximum": 3},
        "role": {"$ref": "#/$defs/role"},
        "lifecycle": {"type": "string", "enum": ["active_matched", "dormant_conditional"]},
        "advancement_eligible": {"type": "boolean"},
        "diagnostic_non_advancing": {"type": "boolean"},
        "hypothesis": {"type": "string", "minLength": 12, "maxLength": 800},
        "declared_axis": {"type": "string", "enum": ["source_fields", "field_order", "field_labels", "unitization", "normalization", "duplicate_handling", "family_aggregation"]},
        "program": {"$ref": "#/$defs/program"},
        "program_sha256": {"$ref": "#/$defs/sha256"},
        "compiled_sha256": {"$ref": "#/$defs/sha256"},
        "compile_sha256s": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/sha256"}},
        "scientific_payload_sha256": {"$ref": "#/$defs/sha256"},
        "matched_ablation_id": {"anyOf": [{"type": "string", "pattern": "^a2-arm-[0-9]{2}-(matched|reserve)-b[1-3]-(exploit|matched-ablation)$"}, {"type": "null"}]},
        "proposer_request_sha256": {"$ref": "#/$defs/sha256"},
        "proposer_event_sha256": {"$ref": "#/$defs/sha256"},
        "reviewer_request_sha256": {"$ref": "#/$defs/sha256"},
        "reviewer_event_sha256": {"$ref": "#/$defs/sha256"},
        "review_verdict": {"type": "string", "const": "accept"},
        "verifier_status": {"type": "string", "const": "accepted"},
        "synthetic_source_sha256": {"$ref": "#/$defs/sha256"},
        "omitted_unit_count": {"type": "integer", "minimum": 0},
        "truncated_span_count": {"type": "integer", "const": 0}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "program_id", "arm_id", "source_fields", "field_order", "field_labels", "unitization", "normalization", "duplicate_policy", "family_aggregation", "preserve_family_identity", "program_sha256"],
      "properties": {
        "schema_version": {"type": "string", "const": "myis.armindex-representation-program.v1"},
        "program_id": {"type": "string", "pattern": "^a2-arm-[0-9]{2}-(matched|reserve)-b[1-3]-(exploit|matched-ablation|orthogonal|diversity)$"},
        "arm_id": {"$ref": "#/$defs/armId"},
        "source_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["title", "abstract", "claims_text"]}},
        "field_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["title", "abstract", "claims_text"]}},
        "field_labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "unitization": {"type": "object", "additionalProperties": false, "required": ["kind", "logical_size", "overlap"], "properties": {"kind": {"type": "string", "enum": ["family", "field", "section", "passage"]}, "logical_size": {"anyOf": [{"type": "integer", "minimum": 32}, {"type": "null"}]}, "overlap": {"type": "integer", "minimum": 0}}},
        "normalization": {"type": "string", "enum": ["unicode_nfkc_whitespace", "unicode_nfkc_whitespace_lower"]},
        "duplicate_policy": {"type": "string", "enum": ["content_hash_first", "preserve_all"]},
        "family_aggregation": {"type": "string", "enum": ["maxp", "avg_top3", "single_unit"]},
        "preserve_family_identity": {"type": "boolean", "const": true},
        "program_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
