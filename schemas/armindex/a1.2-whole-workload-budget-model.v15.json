{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-whole-workload-budget-model.v15.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "status", "claim_boundary", "source", "workload", "frozen_hard_stops_usd", "execution_window", "live_admission", "model_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-whole-workload-budget-model.v15"},
    "model_id": {"const": "a1.2-whole-workload-budget-model-v15"},
    "status": {"const": "LOCAL_MODEL_PENDING_LIVE_PROVIDER"},
    "claim_boundary": {"type": "string", "minLength": 160},
    "source": {"type": "object", "additionalProperties": false, "required": ["binding_set_relative_path", "binding_set_sha256"], "properties": {"binding_set_relative_path": {"const": "v15/receipts/A1_2_COMPILED_PROGRAM_BINDINGS_V15.json"}, "binding_set_sha256": {"$ref": "#/$defs/hash"}}},
    "workload": {"type": "object", "additionalProperties": false, "required": ["arm_count", "program_count", "program_arm_cells", "rep_dev_queries", "reserved_harness_dev_queries", "corpus_logical_units", "physical_window_total", "raw_overflow_logical_inputs", "corpus_overflow_logical_units", "query_overflow_logical_units"], "properties": {"arm_count": {"const": 5}, "program_count": {"const": 5}, "program_arm_cells": {"const": 25}, "rep_dev_queries": {"const": 150}, "reserved_harness_dev_queries": {"const": 100}, "corpus_logical_units": {"const": 45336}, "physical_window_total": {"type": "integer", "minimum": 1}, "raw_overflow_logical_inputs": {"type": "integer", "minimum": 0}, "corpus_overflow_logical_units": {"type": "integer", "minimum": 0}, "query_overflow_logical_units": {"type": "integer", "minimum": 0}}},
    "frozen_hard_stops_usd": {"type": "object", "additionalProperties": false, "required": ["common_screen", "a1_total", "campaign"], "properties": {"common_screen": {"const": 18}, "a1_total": {"const": 23}, "campaign": {"const": 100}}},
    "execution_window": {"type": "object", "additionalProperties": false, "required": ["owner_ttl_hours", "whole_workload_required", "partial_arm_admission_allowed"], "properties": {"owner_ttl_hours": {"const": 6}, "whole_workload_required": {"const": true}, "partial_arm_admission_allowed": {"const": false}}},
    "live_admission": {"type": "object", "additionalProperties": false, "required": ["fresh_provider_identity", "fresh_all_fee_quote", "whole_workload_live_budget_admission", "live_provider_admission_receipt", "admitted", "launch_allowed"], "properties": {"fresh_provider_identity": {"const": "PENDING_LIVE_PROVIDER"}, "fresh_all_fee_quote": {"const": "PENDING_LIVE_PROVIDER"}, "whole_workload_live_budget_admission": {"const": "PENDING_LIVE_PROVIDER"}, "live_provider_admission_receipt": {"const": "PENDING_LIVE_PROVIDER"}, "admitted": {"const": false}, "launch_allowed": {"const": false}}},
    "model_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
