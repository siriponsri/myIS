{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:myis:armindex:a2-execution-ledger-entry:v1","type":"object","additionalProperties":false,"required":["schema_version","entry_id","attempt_id","event_type","status","summary","timestamp_utc","previous_entry_sha256","freeze_bindings","evidence_class","scientific_authority","entry_sha256"],"properties":{"schema_version":{"const":"myis.armindex-a2-execution-ledger-entry.v1"},"entry_id":{"pattern":"^[A-Z0-9-]+$"},"attempt_id":{"pattern":"^a2-[a-z0-9-]{7,63}$"},"event_type":{"enum":["execution_contract_initialized","provider_admission","bundle_staged","execution_adoption","external_execution_requested","failed_closed","safe_return"]},"status":{"enum":["MEASUREMENT_LOCKED","PASS","FAILED_CLOSED","EXTERNAL_EXECUTION_REQUESTED_NOT_LAUNCHED","SAFE_RETURNED"]},"summary":{"type":"string","minLength":1},"timestamp_utc":{"type":"string","format":"date-time"},"previous_entry_sha256":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/hash"}]},"freeze_bindings":{"$ref":"#/$defs/freeze"},"evidence_class":{"const":"engineering_execution_readiness"},"scientific_authority":{"const":false},"entry_sha256":{"$ref":"#/$defs/hash"}},"$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"freeze":{"type":"object","additionalProperties":false,"required":["manifest_sha256","freeze_receipt_sha256","lock_sha256"],"properties":{"manifest_sha256":{"$ref":"#/$defs/hash"},"freeze_receipt_sha256":{"$ref":"#/$defs/hash"},"lock_sha256":{"$ref":"#/$defs/hash"}}}}}
