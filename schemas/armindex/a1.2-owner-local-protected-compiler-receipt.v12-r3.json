{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-owner-local-protected-compiler-receipt.v12-r3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "claim_boundary", "handoff_receipt_sha256", "protected_transfer_manifest_sha256", "pre_adoption_anchor_sha256", "corpus_bundle_sha256", "query_bundle_sha256", "split_commitment_sha256", "evaluator_sha256", "ephemeral_token_map_sha256", "binding_set_sha256", "binding_count", "coverage_gap_count", "omitted_unit_count", "truncation_count", "overlength_count", "launch_allowed", "adopted_for_execution", "measured_runs", "charged_usd", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-owner-local-protected-compiler-receipt.v12-r3"},
    "status": {"const": "PASS"},
    "claim_boundary": {"minLength": 160, "type": "string"},
    "handoff_receipt_sha256": {"$ref": "#/$defs/hash"},
    "protected_transfer_manifest_sha256": {"$ref": "#/$defs/hash"},
    "pre_adoption_anchor_sha256": {"$ref": "#/$defs/hash"},
    "corpus_bundle_sha256": {"$ref": "#/$defs/hash"},
    "query_bundle_sha256": {"$ref": "#/$defs/hash"},
    "split_commitment_sha256": {"$ref": "#/$defs/hash"},
    "evaluator_sha256": {"$ref": "#/$defs/hash"},
    "ephemeral_token_map_sha256": {"$ref": "#/$defs/hash"},
    "binding_set_sha256": {"$ref": "#/$defs/hash"},
    "binding_count": {"const": 25},
    "coverage_gap_count": {"const": 0},
    "omitted_unit_count": {"const": 0},
    "truncation_count": {"const": 0},
    "overlength_count": {"const": 0},
    "launch_allowed": {"const": false},
    "adopted_for_execution": {"const": false},
    "measured_runs": {"const": 0},
    "charged_usd": {"const": 0},
    "receipt_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"pattern": "^[a-f0-9]{64}$", "type": "string"}}
}
