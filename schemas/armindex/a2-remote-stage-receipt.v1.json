{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:a2-remote-stage-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "attempt_id", "status", "remote_root", "remote_root_created_fresh", "bundle_sha256", "staged_bundle_sha256", "watchdog_sha256", "watchdog_pid", "watchdog_linux_proc_start_time", "watchdog_heartbeat_observed", "zero_workers_before_stage", "a1_root_mutated", "provider_destroy_performed", "measured_a2_started", "freeze_bindings", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a2-remote-stage-receipt.v1"},
    "receipt_id": {"pattern": "^a2-[a-z0-9-]+-remote-stage-v1$"},
    "attempt_id": {"pattern": "^a2-[a-z0-9-]{7,63}$"},
    "status": {"const": "PASS_A2_REMOTE_STAGE_NOT_LAUNCHED"},
    "remote_root": {"pattern": "^/opt/myis/a2-[a-z0-9][a-z0-9-]{7,63}$"},
    "remote_root_created_fresh": {"const": true},
    "bundle_sha256": {"$ref": "#/$defs/hash"},
    "staged_bundle_sha256": {"$ref": "#/$defs/hash"},
    "watchdog_sha256": {"$ref": "#/$defs/hash"},
    "watchdog_pid": {"type": "integer", "minimum": 1},
    "watchdog_linux_proc_start_time": {"pattern": "^[0-9]+$"},
    "watchdog_heartbeat_observed": {"const": true},
    "zero_workers_before_stage": {"const": true},
    "a1_root_mutated": {"const": false},
    "provider_destroy_performed": {"const": false},
    "measured_a2_started": {"const": false},
    "freeze_bindings": {"$ref": "#/$defs/freeze"},
    "receipt_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "freeze": {"type": "object", "additionalProperties": false, "required": ["manifest_sha256", "freeze_receipt_sha256", "lock_sha256"], "properties": {"manifest_sha256": {"$ref": "#/$defs/hash"}, "freeze_receipt_sha256": {"$ref": "#/$defs/hash"}, "lock_sha256": {"$ref": "#/$defs/hash"}}}}
}
