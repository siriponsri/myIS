{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-live-preflight-correction.v6.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "revision_id", "status", "evidence_class", "scientific_authority", "claim_boundary", "v5_receipt_sha256", "contract_sha256", "observed_live_defects", "launch_allowed", "adopted_for_execution", "measured_runs", "selection_accesses", "final_accesses", "bindings", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-live-preflight-correction.v6"},
    "receipt_id": {"const": "a1.2-live-preflight-correction-v6"},
    "revision_id": {"const": "a1.2-live-preflight-correction-v6"},
    "status": {"const": "live_correction_prepared_preflight_pending"},
    "evidence_class": {"const": "live_engineering_preflight_correction"},
    "scientific_authority": {"const": false},
    "claim_boundary": {"type": "string", "minLength": 20},
    "v5_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_live_defects": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "launch_allowed": {"const": false},
    "adopted_for_execution": {"const": false},
    "measured_runs": {"const": 0},
    "selection_accesses": {"const": 0},
    "final_accesses": {"const": 0},
    "bindings": {"type": "array", "minItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["uri", "sha256"], "properties": {"uri": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
