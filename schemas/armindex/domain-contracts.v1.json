    "FamilyDocument": {
      "additionalProperties": false,
      "properties": {
        "commercial_status": {
          "enum": [
            "commercial_capable",
            "research_non_commercial",
            "mixed",
            "not_applicable"
          ],
          "title": "Commercial Status",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "synthetic_fixture",
            "engineering",
            "aggregate_evidence",
            "contract_only"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "family_id": {
          "minLength": 1,
          "title": "Family Id",
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Fields",
          "type": "object"
        },
        "protected_data_accessed": {
          "const": false,
          "title": "Protected Data Accessed",
          "type": "boolean"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "schema_version": {
          "const": "myis.armindex-family-document.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_authority": {
          "title": "Scientific Authority",
          "type": "boolean"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "minItems": 1,
          "title": "Source Spans",
          "type": "array"
        }
      },
      "required": [
        "contract_id",
        "evidence_class",
        "scientific_authority",
        "commercial_status",
        "protected_data_accessed",
        "contract_sha256",
        "schema_version",
        "family_id",
        "publication_id",
        "fields",
        "source_spans",
        "document_sha256"
      ],
      "title": "FamilyDocument",
      "type": "object"
    },
