{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-scientific-execution-adoption-inputs-receipt.v12-r3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "revision_id", "status", "evidence_class", "scientific_authority", "claim_boundary", "contract", "execution_bundle", "pre_adoption_anchor", "protected_transfer", "owner_local_receipt", "compiled_bindings", "watchdog_destroy_dry_run", "pending_live_provider", "ready_for_live_adoption_goal", "authorization", "counters", "next_authorized_action", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-scientific-execution-adoption-inputs-receipt.v12-r3"},
    "receipt_id": {"const": "a1.2-scientific-execution-adoption-inputs-v12-r3"},
    "revision_id": {"const": "a1.2-scientific-execution-adoption-inputs-v12-r3"},
    "status": {"const": "LOCAL_INPUTS_VALIDATED_PENDING_LIVE_PROVIDER"},
    "evidence_class": {"const": "scientific_execution_adoption_input_preparation"},
    "scientific_authority": {"const": false},
    "claim_boundary": {"type": "string", "minLength": 160},
    "contract": {"$ref": "#/$defs/contract"},
    "execution_bundle": {"$ref": "#/$defs/bundle"},
    "pre_adoption_anchor": {"$ref": "#/$defs/anchor"},
    "protected_transfer": {"$ref": "#/$defs/transfer"},
    "owner_local_receipt": {"$ref": "#/$defs/owner"},
    "compiled_bindings": {"$ref": "#/$defs/compiled"},
    "watchdog_destroy_dry_run": {"$ref": "#/$defs/watchdog"},
    "pending_live_provider": {"const": ["fresh_provider_identity", "fresh_all_fee_quote", "whole_workload_live_budget_admission", "live_provider_admission_receipt"]},
    "ready_for_live_adoption_goal": {"const": true},
    "authorization": {"$ref": "#/$defs/auth"},
    "counters": {"$ref": "#/$defs/counters"},
    "next_authorized_action": {"type": "string", "minLength": 120},
    "receipt_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contract": {"type": "object", "additionalProperties": false, "required": ["uri", "file_sha256", "contract_sha256"], "properties": {"uri": {"const": "control/armindex/a1.2/scientific-execution-adoption-inputs.v12-r3.json"}, "file_sha256": {"$ref": "#/$defs/hash"}, "contract_sha256": {"$ref": "#/$defs/hash"}}},
    "bundle": {"type": "object", "additionalProperties": false, "required": ["git_commit", "git_tree", "frozen_bundle_sha256", "bundle_manifest_sha256", "receipt_sha256"], "properties": {"git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "git_tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "frozen_bundle_sha256": {"$ref": "#/$defs/hash"}, "bundle_manifest_sha256": {"$ref": "#/$defs/hash"}, "receipt_sha256": {"$ref": "#/$defs/hash"}}},
    "anchor": {"type": "object", "additionalProperties": false, "required": ["anchor_file_sha256", "anchor_sha256"], "properties": {"anchor_file_sha256": {"$ref": "#/$defs/hash"}, "anchor_sha256": {"$ref": "#/$defs/hash"}}},
    "transfer": {"type": "object", "additionalProperties": false, "required": ["transfer_file_sha256", "manifest_sha256"], "properties": {"transfer_file_sha256": {"$ref": "#/$defs/hash"}, "manifest_sha256": {"$ref": "#/$defs/hash"}}},
    "owner": {"type": "object", "additionalProperties": false, "required": ["handoff_receipt_sha256", "protected_transfer_manifest_sha256", "pre_adoption_anchor_sha256", "corpus_bundle_sha256", "query_bundle_sha256", "split_commitment_sha256", "evaluator_sha256", "ephemeral_token_map_sha256", "receipt_sha256"], "properties": {"handoff_receipt_sha256": {"$ref": "#/$defs/hash"}, "protected_transfer_manifest_sha256": {"$ref": "#/$defs/hash"}, "pre_adoption_anchor_sha256": {"$ref": "#/$defs/hash"}, "corpus_bundle_sha256": {"$ref": "#/$defs/hash"}, "query_bundle_sha256": {"$ref": "#/$defs/hash"}, "split_commitment_sha256": {"$ref": "#/$defs/hash"}, "evaluator_sha256": {"$ref": "#/$defs/hash"}, "ephemeral_token_map_sha256": {"$ref": "#/$defs/hash"}, "receipt_sha256": {"$ref": "#/$defs/hash"}}},
    "compiled": {"type": "object", "additionalProperties": false, "required": ["binding_set_sha256", "binding_count", "coverage_gap_count", "omitted_unit_count", "truncation_count", "overlength_count"], "properties": {"binding_set_sha256": {"$ref": "#/$defs/hash"}, "binding_count": {"const": 25}, "coverage_gap_count": {"const": 0}, "omitted_unit_count": {"const": 0}, "truncation_count": {"const": 0}, "overlength_count": {"const": 0}}},
    "watchdog": {"type": "object", "additionalProperties": false, "required": ["receipt_sha256", "target_instance_identity_sha256", "actual_provider_destroy_capability"], "properties": {"receipt_sha256": {"$ref": "#/$defs/hash"}, "target_instance_identity_sha256": {"$ref": "#/$defs/hash"}, "actual_provider_destroy_capability": {"const": "PENDING_LIVE_PROVIDER"}}},
    "auth": {"type": "object", "additionalProperties": false, "required": ["provider_contact_allowed", "launch_allowed", "adopted_for_execution", "measured_retrieval_allowed"], "properties": {"provider_contact_allowed": {"const": false}, "launch_allowed": {"const": false}, "adopted_for_execution": {"const": false}, "measured_retrieval_allowed": {"const": false}}},
    "counters": {"type": "object", "additionalProperties": false, "required": ["measured_runs", "selection_accesses", "final_accesses", "charged_usd"], "properties": {"measured_runs": {"const": 0}, "selection_accesses": {"const": 0}, "final_accesses": {"const": 0}, "charged_usd": {"const": 0}}}
  }
}
