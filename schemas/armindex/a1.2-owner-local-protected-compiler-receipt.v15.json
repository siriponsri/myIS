{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-owner-local-protected-compiler-receipt.v15.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "claim_boundary", "integration_file_sha256", "handoff_receipt_sha256", "protected_transfer_manifest_sha256", "pre_compilation_anchor_sha256", "corpus_bundle_sha256", "query_bundle_sha256", "split_commitment_sha256", "evaluator_sha256", "ephemeral_token_map_sha256", "binding_set_sha256", "binding_count", "coverage_gap_count", "omitted_unit_count", "truncation_count", "overlength_count", "raw_overflow_count", "zero_silent_truncation", "deterministic_replay", "launch_allowed", "adopted_for_execution", "measured_runs", "charged_usd", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-owner-local-protected-compiler-receipt.v15"},
    "status": {"const": "PASS"},
    "claim_boundary": {"type": "string", "minLength": 180},
    "integration_file_sha256": {"$ref": "#/$defs/hash"},
    "handoff_receipt_sha256": {"$ref": "#/$defs/hash"},
    "protected_transfer_manifest_sha256": {"$ref": "#/$defs/hash"},
    "pre_compilation_anchor_sha256": {"$ref": "#/$defs/hash"},
    "corpus_bundle_sha256": {"$ref": "#/$defs/hash"},
    "query_bundle_sha256": {"$ref": "#/$defs/hash"},
    "split_commitment_sha256": {"$ref": "#/$defs/hash"},
    "evaluator_sha256": {"$ref": "#/$defs/hash"},
    "ephemeral_token_map_sha256": {"$ref": "#/$defs/hash"},
    "binding_set_sha256": {"$ref": "#/$defs/hash"},
    "binding_count": {"const": 25},
    "coverage_gap_count": {"const": 0},
    "omitted_unit_count": {"const": 0},
    "truncation_count": {"const": 0},
    "overlength_count": {"const": 0},
    "raw_overflow_count": {"type": "integer", "minimum": 0},
    "zero_silent_truncation": {"const": true},
    "deterministic_replay": {"const": true},
    "launch_allowed": {"const": false},
    "adopted_for_execution": {"const": false},
    "measured_runs": {"const": 0},
    "charged_usd": {"const": 0},
    "receipt_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
