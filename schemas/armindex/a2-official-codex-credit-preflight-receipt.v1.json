{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:a2-official-codex-credit-preflight-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "campaign_id", "phase_id", "task_id", "status", "evidence_class", "scientific_authority", "operation", "checkpoint_id", "snapshot_sha256", "snapshot_pointer", "observed_at_utc", "model_name", "sdk_version", "plan_type", "used_percent", "remaining_percent", "window_duration_mins", "resets_at_utc", "rate_limit_reached_type", "reset_credit_available_count", "reset_credit_consumed", "limit_reached", "forbidden_account_fields_exposed", "protected_data_accessed", "measured_execution_performed", "provider_admission_performed", "provider_execution_adoption_performed", "official_docs", "receipt_sha256"],
  "properties": {
    "schema_version": {"type": "string", "const": "myis.armindex-a2-official-codex-credit-preflight-receipt.v1"},
    "receipt_id": {"type": "string", "pattern": "^a2-official-codex-credit-preflight-[a-z0-9]+$"},
    "campaign_id": {"type": "string", "const": "armindex-multiretriever-v2"},
    "phase_id": {"type": "string", "const": "A2_PER_ARM_AUTOINDEX"},
    "task_id": {"type": "string", "const": "OFFICIAL_CODEX_BRIDGE_AND_CANDIDATE_FREEZE"},
    "status": {"type": "string", "const": "PASS_OFFICIAL_CREDIT_AVAILABLE"},
    "evidence_class": {"type": "string", "const": "engineering_validation"},
    "scientific_authority": {"type": "boolean", "const": false},
    "operation": {"type": "string", "const": "account/rateLimits/read"},
    "checkpoint_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_pointer": {"type": "string", "pattern": "^owner-local://official-codex/"},
    "observed_at_utc": {"$ref": "#/$defs/timestamp"},
    "model_name": {"type": "string", "const": "gpt-5.6-sol"},
    "sdk_version": {"type": "string", "const": "0.144.4"},
    "plan_type": {"type": "string", "minLength": 1},
    "used_percent": {"type": "integer", "minimum": 0, "maximum": 99},
    "remaining_percent": {"type": "integer", "minimum": 1, "maximum": 100},
    "window_duration_mins": {"type": "integer", "minimum": 1},
    "resets_at_utc": {"$ref": "#/$defs/timestamp"},
    "rate_limit_reached_type": {"type": "null"},
    "reset_credit_available_count": {"type": "integer", "minimum": 0},
    "reset_credit_consumed": {"type": "boolean", "const": false},
    "limit_reached": {"type": "boolean", "const": false},
    "forbidden_account_fields_exposed": {"type": "boolean", "const": false},
    "protected_data_accessed": {"type": "boolean", "const": false},
    "measured_execution_performed": {"type": "boolean", "const": false},
    "provider_admission_performed": {"type": "boolean", "const": false},
    "provider_execution_adoption_performed": {"type": "boolean", "const": false},
    "official_docs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "string", "pattern": "^https://developers\\.openai\\.com/codex/"}
    },
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
