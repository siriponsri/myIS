{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:myis:armindex:a2-live-remote-probe-receipt:v2","type":"object","additionalProperties":false,"required":["schema_version","receipt_id","attempt_id","status","observed_at_utc","provider_instance_id","provider_instance_binding_sha256","ssh_host_key_sha256","runtime_sha256","gpu_uuid_set_sha256","gpu_count","gpu_model","vram_mib_each","gpu_compute_process_count","a2_process_count","model_lockset_sha256","data_handoff_sha256","bundle_sha256","remote_root","remote_root_absent","ttl_deadline_utc","remaining_ttl_seconds","receipt_sha256"],"properties":{"schema_version":{"const":"myis.armindex-a2-live-remote-probe-receipt.v2"},"receipt_id":{"pattern":"^a2-[a-z0-9-]+-live-remote-probe-v2$"},"attempt_id":{"pattern":"^a2-[a-z0-9-]{7,63}$"},"status":{"const":"PASS_A2_LIVE_REMOTE_PROBE"},"observed_at_utc":{"type":"string","format":"date-time"},"provider_instance_id":{"pattern":"^[1-9][0-9]{3,19}$"},"provider_instance_binding_sha256":{"$ref":"#/$defs/hash"},"ssh_host_key_sha256":{"$ref":"#/$defs/hash"},"runtime_sha256":{"$ref":"#/$defs/hash"},"gpu_uuid_set_sha256":{"$ref":"#/$defs/hash"},"gpu_count":{"const":4},"gpu_model":{"const":"RTX3090"},"vram_mib_each":{"const":24576},"gpu_compute_process_count":{"const":0},"a2_process_count":{"const":0},"model_lockset_sha256":{"$ref":"#/$defs/hash"},"data_handoff_sha256":{"$ref":"#/$defs/hash"},"bundle_sha256":{"$ref":"#/$defs/hash"},"remote_root":{"pattern":"^/opt/myis/a2-[a-z0-9][a-z0-9-]{7,63}$"},"remote_root_absent":{"const":true},"ttl_deadline_utc":{"type":"string","format":"date-time"},"remaining_ttl_seconds":{"type":"integer","minimum":144000},"receipt_sha256":{"$ref":"#/$defs/hash"}},"$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
