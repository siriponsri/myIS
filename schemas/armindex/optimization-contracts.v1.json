{
  "$defs": {
    "AutoIndexBatch": {
      "additionalProperties": false,
      "properties": {
        "arm_id": {
          "enum": [
            "ARM-01",
            "ARM-02",
            "ARM-03",
            "ARM-04",
            "ARM-05"
          ],
          "title": "Arm Id",
          "type": "string"
        },
        "batch_id": {
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "budget_counters": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Budget Counters",
          "type": "object"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/AutoIndexCandidate"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Candidates",
          "type": "array"
        },
        "commercial_status": {
          "enum": [
            "commercial_capable",
            "research_non_commercial",
            "mixed",
            "not_applicable"
          ],
          "title": "Commercial Status",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "synthetic_fixture",
            "engineering",
            "aggregate_evidence",
            "contract_only"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "incumbent_candidate_id": {
          "minLength": 1,
          "title": "Incumbent Candidate Id",
          "type": "string"
        },
        "iteration": {
          "minimum": 1,
          "title": "Iteration",
          "type": "integer"
        },
        "protected_data_accessed": {
          "const": false,
          "title": "Protected Data Accessed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "myis.armindex-autoindex-batch.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_authority": {
          "title": "Scientific Authority",
          "type": "boolean"
        },
        "status": {
          "const": "frozen_before_evaluation",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "evidence_class",
        "scientific_authority",
        "commercial_status",
        "protected_data_accessed",
        "contract_sha256",
        "schema_version",
        "batch_id",
        "arm_id",
        "iteration",
        "incumbent_candidate_id",
        "status",
        "candidates",
        "budget_counters"
      ],
      "title": "AutoIndexBatch",
      "type": "object"
    },
    "AutoIndexCandidate": {
      "additionalProperties": false,
      "properties": {
        "arm_id": {
          "enum": [
            "ARM-01",
            "ARM-02",
            "ARM-03",
            "ARM-04",
            "ARM-05"
          ],
          "title": "Arm Id",
          "type": "string"
        },
        "axis_values": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "Axis Values",
          "type": "object"
        },
        "candidate_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "commercial_status": {
          "enum": [
            "commercial_capable",
            "research_non_commercial",
            "mixed",
            "not_applicable"
          ],
          "title": "Commercial Status",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "declared_axis": {
          "minLength": 1,
          "title": "Declared Axis",
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "synthetic_fixture",
            "engineering",
            "aggregate_evidence",
            "contract_only"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "hypothesis": {
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "hypothesis_id": {
          "minLength": 1,
          "title": "Hypothesis Id",
          "type": "string"
        },
        "parent_candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Candidate Id"
        },
        "protected_data_accessed": {
          "const": false,
          "title": "Protected Data Accessed",
          "type": "boolean"
        },
        "representation_program_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Representation Program Sha256",
          "type": "string"
        },
        "role": {
          "enum": [
            "exploit",
            "matched_ablation",
            "orthogonal",
            "diversity"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "myis.armindex-autoindex-candidate.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_authority": {
          "title": "Scientific Authority",
          "type": "boolean"
        },
        "scientific_payload_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scientific Payload Sha256",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "evidence_class",
        "scientific_authority",
        "commercial_status",
        "protected_data_accessed",
        "contract_sha256",
        "schema_version",
        "candidate_id",
        "arm_id",
        "hypothesis_id",
        "hypothesis",
        "role",
        "declared_axis",
        "representation_program_sha256",
        "scientific_payload_sha256",
        "axis_values"
      ],
      "title": "AutoIndexCandidate",
      "type": "object"
    },
    "ComplementarityReport": {
      "additionalProperties": false,
      "properties": {
        "aggregate_metric_sha256s": {
          "items": {
            "type": "string"
          },
          "title": "Aggregate Metric Sha256S",
          "type": "array"
        },
        "arm_ids": {
          "items": {
            "enum": [
              "ARM-01",
              "ARM-02",
              "ARM-03",
              "ARM-04",
              "ARM-05"
            ],
            "type": "string"
          },
          "minItems": 2,
          "title": "Arm Ids",
          "type": "array"
        },
        "candidate_depth": {
          "minimum": 1,
          "title": "Candidate Depth",
          "type": "integer"
        },
        "commercial_status": {
          "enum": [
            "commercial_capable",
            "research_non_commercial",
            "mixed",
            "not_applicable"
          ],
          "title": "Commercial Status",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "synthetic_fixture",
            "engineering",
            "aggregate_evidence",
            "contract_only"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "gate_status": {
          "enum": [
            "eligible",
            "ineligible",
            "not_evaluated"
          ],
          "title": "Gate Status",
          "type": "string"
        },
        "pairwise_overlap": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Pairwise Overlap",
          "type": "object"
        },
        "protected_data_accessed": {
          "const": false,
          "title": "Protected Data Accessed",
          "type": "boolean"
        },
        "rank_overlap": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Rank Overlap",
          "type": "object"
        },
        "report_id": {
          "minLength": 1,
          "title": "Report Id",
          "type": "string"
        },
        "schema_version": {
          "const": "myis.armindex-complementarity-report.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_authority": {
          "title": "Scientific Authority",
          "type": "boolean"
        },
        "unique_hit_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Unique Hit Counts",
          "type": "object"
        }
      },
      "required": [
        "contract_id",
        "evidence_class",
        "scientific_authority",
        "commercial_status",
        "protected_data_accessed",
        "contract_sha256",
        "schema_version",
        "report_id",
        "arm_ids",
        "candidate_depth",
        "pairwise_overlap",
        "rank_overlap",
        "unique_hit_counts",
        "aggregate_metric_sha256s",
        "gate_status"
      ],
      "title": "ComplementarityReport",
      "type": "object"
    },
    "FusionConfiguration": {
      "additionalProperties": false,
      "properties": {
        "arm_ids": {
          "items": {
            "enum": [
              "ARM-01",
              "ARM-02",
              "ARM-03",
              "ARM-04",
              "ARM-05"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Arm Ids",
          "type": "array"
        },
        "commercial_status": {
          "enum": [
            "commercial_capable",
            "research_non_commercial",
            "mixed",
            "not_applicable"
          ],
          "title": "Commercial Status",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "synthetic_fixture",
            "engineering",
            "aggregate_evidence",
            "contract_only"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "fusion_id": {
          "minLength": 1,
          "title": "Fusion Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "identity",
            "rrf",
            "weighted_rrf",
            "normalized_rank_sum",
            "lexicographic_union"
          ],
          "title": "Method",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Parameters",
          "type": "object"
        },
        "protected_data_accessed": {
          "const": false,
          "title": "Protected Data Accessed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "myis.armindex-fusion-configuration.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_authority": {
          "title": "Scientific Authority",
          "type": "boolean"
        }
      },
      "required": [
        "contract_id",
        "evidence_class",
        "scientific_authority",
        "commercial_status",
        "protected_data_accessed",
        "contract_sha256",
        "schema_version",
        "fusion_id",
        "method",
        "arm_ids",
        "parameters"
      ],
      "title": "FusionConfiguration",
      "type": "object"
    },
    "TransferEvaluation": {
      "additionalProperties": false,
      "properties": {
        "commercial_status": {
          "enum": [
            "commercial_capable",
            "research_non_commercial",
            "mixed",
            "not_applicable"
          ],
          "title": "Commercial Status",
          "type": "string"
        },
        "compiled_representation_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compiled Representation Sha256"
        },
        "contract_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "synthetic_fixture",
            "engineering",
            "aggregate_evidence",
            "contract_only"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "metric_sha256s": {
          "items": {
            "type": "string"
          },
          "title": "Metric Sha256S",
          "type": "array"
        },
        "protected_data_accessed": {
          "const": false,
          "title": "Protected Data Accessed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "myis.armindex-transfer-evaluation.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_authority": {
          "title": "Scientific Authority",
          "type": "boolean"
        },
        "source_arm_id": {
          "enum": [
            "ARM-01",
            "ARM-02",
            "ARM-03",
            "ARM-04",
            "ARM-05"
          ],
          "title": "Source Arm Id",
          "type": "string"
        },
        "source_program_id": {
          "minLength": 1,
          "title": "Source Program Id",
          "type": "string"
        },
        "target_arm_id": {
          "enum": [
            "ARM-01",
            "ARM-02",
            "ARM-03",
            "ARM-04",
            "ARM-05"
          ],
          "title": "Target Arm Id",
          "type": "string"
        },
        "transfer_id": {
          "minLength": 1,
          "title": "Transfer Id",
          "type": "string"
        },
        "transfer_state": {
          "enum": [
            "exact_logical_transfer",
            "adapter_constrained",
            "unsupported"
          ],
          "title": "Transfer State",
          "type": "string"
        },
        "unsupported_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Reason"
        }
      },
      "required": [
        "contract_id",
        "evidence_class",
        "scientific_authority",
        "commercial_status",
        "protected_data_accessed",
        "contract_sha256",
        "schema_version",
        "transfer_id",
        "source_program_id",
        "source_arm_id",
        "target_arm_id",
        "transfer_state",
        "metric_sha256s"
      ],
      "title": "TransferEvaluation",
      "type": "object"
    }
  },
  "$id": "urn:myis:armindex:optimization-contracts:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/FusionConfiguration"
    },
    {
      "$ref": "#/$defs/TransferEvaluation"
    },
    {
      "$ref": "#/$defs/ComplementarityReport"
    },
    {
      "$ref": "#/$defs/AutoIndexCandidate"
    },
    {
      "$ref": "#/$defs/AutoIndexBatch"
    }
  ],
  "title": "ArmIndex optimization contracts.v1"
}
