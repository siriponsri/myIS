{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:representation-program:v1",
  "title": "ArmIndex executable representation program v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "arm_id", "source_fields", "field_order", "field_labels", "unitization", "normalization", "duplicate_policy", "family_aggregation", "preserve_family_identity", "program_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-representation-program.v1"},
    "program_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "arm_id": {"enum": ["ARM-01", "ARM-02", "ARM-03", "ARM-04", "ARM-05"]},
    "source_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "field_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "field_labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "unitization": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["family", "field", "section", "sentence", "passage"]}, "logical_size": {"type": ["integer", "null"], "minimum": 1}, "overlap": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "normalization": {"enum": ["unicode_nfkc_whitespace", "unicode_nfkc_whitespace_lower"]},
    "duplicate_policy": {"enum": ["content_hash_first", "preserve_all"]},
    "family_aggregation": {"enum": ["maxp", "avg_top3", "single_unit"]},
    "preserve_family_identity": {"const": true},
    "program_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
