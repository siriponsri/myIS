{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-measured-result-summary.v16.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "summary_id", "attempt_id", "phase_id", "task_id",
    "status", "evidence_class", "scientific_authority", "claim_boundary",
    "metric_contract", "coverage", "arm_results", "promoted_arm_ids",
    "lineage", "access_counters", "summary_sha256"
  ],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-measured-result-summary.v16"},
    "summary_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}-measured-result-summary-v16$"},
    "attempt_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "phase_id": {"const": "A1_BASELINES_AND_MULTI_ARM_SCREENING"},
    "task_id": {"const": "A1.2"},
    "status": {"const": "PASS"},
    "evidence_class": {"const": "measured_development_aggregate"},
    "scientific_authority": {"const": true},
    "claim_boundary": {"type": "string", "minLength": 40},
    "metric_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"const": "OUT Recall@100"},
        "secondary": {
          "type": "array",
          "prefixItems": [
            {"const": "OUT nDCG@100"},
            {"const": "OUT nDCG@10"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm_count", "programs_per_arm", "completed_logical_cells", "required_logical_cells"],
      "properties": {
        "arm_count": {"const": 5},
        "programs_per_arm": {"const": 5},
        "completed_logical_cells": {"const": 25},
        "required_logical_cells": {"const": 25}
      }
    },
    "arm_results": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/arm_result"}
    },
    "promoted_arm_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/arm_id"}
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safe_return_archive_sha256", "cell_receipt_set_sha256",
        "promotion_receipt_sha256", "evaluator_closeout_receipt_sha256"
      ],
      "properties": {
        "safe_return_archive_sha256": {"$ref": "#/$defs/hash"},
        "cell_receipt_set_sha256": {"$ref": "#/$defs/hash"},
        "promotion_receipt_sha256": {"$ref": "#/$defs/hash"},
        "evaluator_closeout_receipt_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "access_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_dev_accesses", "selection_accesses", "final_accesses"],
      "properties": {
        "harness_dev_accesses": {"const": 0},
        "selection_accesses": {"const": 0},
        "final_accesses": {"const": 0}
      }
    },
    "summary_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "arm_id": {"enum": ["ARM-01", "ARM-02", "ARM-03", "ARM-04", "ARM-05"]},
    "arm_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_id", "program_count", "out_recall_at_100_mean",
        "out_ndcg_at_100_mean", "out_ndcg_at_10_mean",
        "search_latency_p95_ms_mean", "wall_seconds_sum",
        "failure_rate_mean"
      ],
      "properties": {
        "arm_id": {"$ref": "#/$defs/arm_id"},
        "program_count": {"const": 5},
        "out_recall_at_100_mean": {"$ref": "#/$defs/rate"},
        "out_ndcg_at_100_mean": {"$ref": "#/$defs/rate"},
        "out_ndcg_at_10_mean": {"$ref": "#/$defs/rate"},
        "search_latency_p95_ms_mean": {"type": "number", "minimum": 0},
        "wall_seconds_sum": {"type": "number", "minimum": 0},
        "failure_rate_mean": {"$ref": "#/$defs/rate"}
      }
    }
  }
}
