        "pool_id": {
          "minLength": 1,
          "title": "Pool Id",
          "type": "string"
        },
        "pool_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Pool Sha256",
          "type": "string"
        },
        "protected_data_accessed": {
          "const": false,
          "title": "Protected Data Accessed",
          "type": "boolean"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "myis.armindex-candidate-pool.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_authority": {
          "title": "Scientific Authority",
          "type": "boolean"
        }
