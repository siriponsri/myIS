            "type": "string"
          },
          "minItems": 1,
          "title": "Arm Ids",
          "type": "array"
        },
        "commercial_status": {
          "enum": [
            "commercial_capable",
            "research_non_commercial",
            "mixed",
            "not_applicable"
          ],
          "title": "Commercial Status",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "depth_by_arm": {
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1,
          "title": "Depth By Arm",
          "type": "object"
        },
        "evidence_class": {
          "enum": [
            "synthetic_fixture",
            "engineering",
            "aggregate_evidence",
            "contract_only"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/SearchHit"
          },
          "title": "Hits",
          "type": "array"
