{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:a2-official-codex-post-round-credit-check-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "campaign_id", "phase_id", "task_id",
    "status", "evidence_class", "scientific_authority", "operation",
    "checkpoint_id", "snapshot_sha256", "snapshot_pointer", "observed_at_utc",
    "model_name", "reasoning_effort", "sdk_version", "cli_version", "plan_type",
    "used_percent", "remaining_percent", "window_duration_mins", "resets_at_utc",
    "rate_limit_reached_type", "reset_credit_available_count", "reset_credit_consumed",
    "limit_reached", "official_docs", "protected_data_accessed",
    "measured_execution_performed", "provider_admission_performed",
    "provider_execution_adoption_performed", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "myis.armindex-a2-official-codex-post-round-credit-check-receipt.v1"},
    "receipt_id": {"const": "a2-official-codex-post-round-credit-check-v1"},
    "campaign_id": {"const": "armindex-multiretriever-v2"},
    "phase_id": {"const": "A2_PER_ARM_AUTOINDEX"},
    "task_id": {"const": "OFFICIAL_CODEX_BRIDGE_AND_CANDIDATE_FREEZE"},
    "status": {"const": "PASS_OFFICIAL_CREDIT_AVAILABLE_AFTER_PROJECTION_VALIDATION"},
    "evidence_class": {"const": "engineering_validation"},
    "scientific_authority": {"const": false},
    "operation": {"const": "account/rateLimits/read"},
    "checkpoint_id": {"const": "a2projection-20260812t035456z-credit"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_pointer": {"type": "string", "pattern": "^owner-local://official-codex/"},
    "observed_at_utc": {"$ref": "#/$defs/timestamp"},
    "model_name": {"const": "gpt-5.6-sol"},
    "reasoning_effort": {"const": "high"},
    "sdk_version": {"const": "0.144.4"},
    "cli_version": {"const": "0.144.4"},
    "plan_type": {"type": "string", "minLength": 1},
    "used_percent": {"type": "integer", "minimum": 0, "maximum": 99},
    "remaining_percent": {"type": "integer", "minimum": 1, "maximum": 100},
    "window_duration_mins": {"type": "integer", "minimum": 1},
    "resets_at_utc": {"$ref": "#/$defs/timestamp"},
    "rate_limit_reached_type": {"type": "null"},
    "reset_credit_available_count": {"type": "integer", "minimum": 0},
    "reset_credit_consumed": {"const": false},
    "limit_reached": {"const": false},
    "official_docs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "string", "pattern": "^https://developers\\.openai\\.com/codex/"}
    },
    "protected_data_accessed": {"const": false},
    "measured_execution_performed": {"const": false},
    "provider_admission_performed": {"const": false},
    "provider_execution_adoption_performed": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
