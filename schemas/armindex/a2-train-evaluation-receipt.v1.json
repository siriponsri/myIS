{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:myis:armindex:a2-train-evaluation-receipt:v1","type":"object","additionalProperties":false,"required":["schema_version","receipt_id","attempt_id","status","candidate_id","arm_id","aggregate_metrics_sha256","aggregate_metric_count","train_only","rep_dev_measured","per_query_outcomes_included","freeze_bindings","receipt_sha256"],"properties":{"schema_version":{"const":"myis.armindex-a2-train-evaluation-receipt.v1"},"receipt_id":{"pattern":"^a2-[a-z0-9-]+-train-evaluation-v1$"},"attempt_id":{"pattern":"^a2-[a-z0-9-]{7,63}$"},"status":{"const":"PASS_A2_TRAIN_EVALUATION"},"candidate_id":{"pattern":"^a2-arm-0[1-5]-(matched|reserve)-b[1-3]-(exploit|matched-ablation|orthogonal|diversity)$"},"arm_id":{"enum":["ARM-01","ARM-02","ARM-03","ARM-04","ARM-05"]},"aggregate_metrics_sha256":{"$ref":"#/$defs/hash"},"aggregate_metric_count":{"type":"integer","minimum":1},"train_only":{"const":true},"rep_dev_measured":{"const":false},"per_query_outcomes_included":{"const":false},"freeze_bindings":{"$ref":"#/$defs/freeze"},"receipt_sha256":{"$ref":"#/$defs/hash"}},"$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"freeze":{"type":"object","additionalProperties":false,"required":["manifest_sha256","freeze_receipt_sha256","lock_sha256"],"properties":{"manifest_sha256":{"$ref":"#/$defs/hash"},"freeze_receipt_sha256":{"$ref":"#/$defs/hash"},"lock_sha256":{"$ref":"#/$defs/hash"}}}}}
