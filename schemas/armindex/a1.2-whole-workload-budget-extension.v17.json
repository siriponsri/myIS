{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-whole-workload-budget-extension.v17.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision_id", "status", "claim_boundary", "owner_decision", "historical_v16", "approved_limits", "prior_attempt_accounting", "all_fee_admission", "authorization", "preparation_counters", "policy_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-whole-workload-budget-extension.v17"},
    "revision_id": {"const": "a1.2-whole-workload-budget-extension-v17"},
    "status": {"const": "OWNER_APPROVED_PENDING_LIVE_PROVIDER"},
    "claim_boundary": {"type": "string", "minLength": 180},
    "owner_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "decision_date", "source", "rationale", "publication_impact_boundary"],
      "properties": {
        "decision": {"const": "EXTEND_FRESH_RERUN_BUDGET_WITH_PRIOR_ATTEMPT_ACCOUNTING"},
        "decision_date": {"const": "2026-08-11"},
        "source": {"const": "Owner current-thread approval"},
        "rationale": {"type": "string", "minLength": 100},
        "publication_impact_boundary": {"type": "string", "minLength": 100}
      }
    },
    "historical_v16": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_uri", "policy_sha256", "hard_stops_usd", "owner_ttl_hours", "semantics"],
      "properties": {
        "policy_uri": {"const": "control/armindex/a1.2/whole-workload-budget-extension.v16.json"},
        "policy_sha256": {"const": "bf0eedc8aedcf1dd9d8ec28d3101681fc4a0e3c8623d0585eb6271b62fd44f06"},
        "hard_stops_usd": {"$ref": "#/$defs/v16_hard_stops"},
        "owner_ttl_hours": {"const": 40},
        "semantics": {"const": "PRESERVED_IMMUTABLE_REFERENCE"}
      }
    },
    "approved_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "hard_stops_usd", "owner_ttl_hours", "ttl_basis", "whole_workload_required", "partial_arm_admission_allowed", "quote_max_age_seconds"],
      "properties": {
        "currency": {"const": "USD"},
        "hard_stops_usd": {"$ref": "#/$defs/v17_hard_stops"},
        "owner_ttl_hours": {"const": 40},
        "ttl_basis": {"const": "FROM_INSTANCE_PROVISION"},
        "whole_workload_required": {"const": true},
        "partial_arm_admission_allowed": {"const": false},
        "quote_max_age_seconds": {"const": 900}
      }
    },
    "prior_attempt_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_prior_attempt_count", "accounting_basis", "current_ttl_charge_added_to_every_hard_stop", "aggregate_only"],
      "properties": {
        "required_prior_attempt_count": {"const": 1},
        "accounting_basis": {"const": "ALL_FEE_DESTROYED_ATTEMPT_TOTAL"},
        "current_ttl_charge_added_to_every_hard_stop": {"const": true},
        "aggregate_only": {"const": true}
      }
    },
    "all_fee_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh_provider_identity_required", "fresh_quote_required", "required_quote_fields", "unknown_billable_component_allowed", "whole_workload_charge_must_fit_all_stops", "formula"],
      "properties": {
        "fresh_provider_identity_required": {"const": true},
        "fresh_quote_required": {"const": true},
        "required_quote_fields": {"type": "array", "const": ["quote_observed_at_utc", "compute_hourly_rate_usd", "billing_granularity_seconds", "minimum_billable_seconds", "storage_fee_usd", "network_fee_usd", "platform_or_other_fee_usd", "tax_or_surcharge_usd"]},
        "unknown_billable_component_allowed": {"const": false},
        "whole_workload_charge_must_fit_all_stops": {"const": true},
        "formula": {"type": "string", "minLength": 100}
      }
    },
    "authorization": {"$ref": "#/$defs/locked_authorization"},
    "preparation_counters": {"$ref": "#/$defs/zero_counters"},
    "policy_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "v16_hard_stops": {"type": "object", "additionalProperties": false, "required": ["common_screen", "a1_total", "campaign"], "properties": {"common_screen": {"const": 27}, "a1_total": {"const": 32}, "campaign": {"const": 150}}},
    "v17_hard_stops": {"type": "object", "additionalProperties": false, "required": ["common_screen", "a1_total", "campaign"], "properties": {"common_screen": {"const": 55}, "a1_total": {"const": 60}, "campaign": {"const": 150}}},
    "locked_authorization": {"type": "object", "additionalProperties": false, "required": ["provider_contact_allowed", "admitted", "launch_allowed", "adopted_for_execution", "measured_retrieval_allowed"], "properties": {"provider_contact_allowed": {"const": false}, "admitted": {"const": false}, "launch_allowed": {"const": false}, "adopted_for_execution": {"const": false}, "measured_retrieval_allowed": {"const": false}}},
    "zero_counters": {"type": "object", "additionalProperties": false, "required": ["charged_usd", "gpu_scientific_runs", "measured_runs", "model_downloads", "paid_api_calls"], "properties": {"charged_usd": {"const": 0}, "gpu_scientific_runs": {"const": 0}, "measured_runs": {"const": 0}, "model_downloads": {"const": 0}, "paid_api_calls": {"const": 0}}}
  }
}
