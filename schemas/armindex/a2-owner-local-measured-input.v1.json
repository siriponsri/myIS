{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:a2-owner-local-measured-input:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "attempt_id", "a1_v16_bindings", "arm_incumbents", "owner_artifacts", "engine", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a2-owner-local-measured-input.v1"},
    "status": {"const": "READY"},
    "attempt_id": {"pattern": "^a2-[a-z0-9-]{7,63}$"},
    "a1_v16_bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_lock_sha256", "model_lockset_sha256", "data_handoff_sha256", "evaluator_receipt_sha256"],
      "properties": {
        "runtime_lock_sha256": {"$ref": "#/$defs/hash"},
        "model_lockset_sha256": {"$ref": "#/$defs/hash"},
        "data_handoff_sha256": {"$ref": "#/$defs/hash"},
        "evaluator_receipt_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "arm_incumbents": {
      "type": "object", "additionalProperties": false,
      "required": ["ARM-03", "ARM-05", "ARM-04"],
      "properties": {
        "ARM-03": {"$ref": "#/$defs/incumbent"},
        "ARM-05": {"$ref": "#/$defs/incumbent"},
        "ARM-04": {"$ref": "#/$defs/incumbent"}
      }
    },
    "owner_artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "model_lockset", "data_handoff", "evaluator", "corpus", "queries", "qrels", "membership"],
      "properties": {
        "runtime": {"$ref": "#/$defs/artifact"},
        "model_lockset": {"$ref": "#/$defs/artifact"},
        "data_handoff": {"$ref": "#/$defs/artifact"},
        "evaluator": {"$ref": "#/$defs/artifact"},
        "corpus": {"$ref": "#/$defs/artifact"},
        "queries": {"$ref": "#/$defs/artifact"},
        "qrels": {"$ref": "#/$defs/artifact"},
        "membership": {"$ref": "#/$defs/artifact"}
      }
    },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["engine_id", "argv", "code_sha256", "model_directories", "output_root"],
      "properties": {
        "engine_id": {"const": "myis.armindex-a2-owner-local-retriever-evaluator.v1"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "code_sha256": {"$ref": "#/$defs/hash"},
        "model_directories": {
          "type": "object", "additionalProperties": false,
          "required": ["ARM-02", "ARM-03", "ARM-04", "ARM-05"],
          "properties": {
            "ARM-02": {"type": "string", "minLength": 1},
            "ARM-03": {"type": "string", "minLength": 1},
            "ARM-04": {"type": "string", "minLength": 1},
            "ARM-05": {"type": "string", "minLength": 1}
          }
        },
        "output_root": {"type": "string", "minLength": 1}
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "binding_sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "binding_sha256": {"$ref": "#/$defs/hash"}}
    },
    "incumbent": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "program_sha256", "primary_metric"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "program_sha256": {"$ref": "#/$defs/hash"},
        "primary_metric": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
      }
    }
  }
}
