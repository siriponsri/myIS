{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:a2-candidate-freeze-replay-validation:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validation_id", "phase_id", "task_id", "status", "evidence_class", "scientific_authority", "claim_boundary", "generation_attempt_id", "candidate_count", "matched_candidate_count", "conditional_reserve_candidate_count", "manifest_sha256", "freeze_receipt_sha256", "lock_sha256", "model_name", "plan_type", "remaining_percent", "resets_at_utc", "limit_reached", "measured_a2_started", "protected_data_accessed", "validated_from_revision", "validation_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a2-candidate-freeze-replay-validation.v1"},
    "validation_id": {"const": "a2-five-arm-candidate-freeze-replay-v1"},
    "phase_id": {"const": "A2_PER_ARM_AUTOINDEX"},
    "task_id": {"const": "OFFICIAL_CODEX_BRIDGE_AND_CANDIDATE_FREEZE"},
    "status": {"const": "PASS_A2_CANDIDATE_FREEZE_REPLAY"},
    "evidence_class": {"const": "engineering_validation"},
    "scientific_authority": {"const": false},
    "claim_boundary": {"type": "string", "minLength": 20},
    "generation_attempt_id": {"type": "string", "pattern": "^a2freeze-[0-9]{8}t[0-9]{6}z$"},
    "candidate_count": {"const": 52},
    "matched_candidate_count": {"const": 40},
    "conditional_reserve_candidate_count": {"const": 12},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "freeze_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "lock_sha256": {"$ref": "#/$defs/sha256"},
    "model_name": {"const": "gpt-5.6-sol"},
    "plan_type": {"type": "string", "minLength": 1},
    "remaining_percent": {"type": "integer", "minimum": 1, "maximum": 100},
    "resets_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "limit_reached": {"const": false},
    "measured_a2_started": {"const": false},
    "protected_data_accessed": {"const": false},
    "validated_from_revision": {"$ref": "#/$defs/sha256"},
    "validation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
