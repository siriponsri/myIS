{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-provider-admission-input.v12.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "template_file_sha256", "template_sha256", "observed_at_utc", "provider_identity", "runtime_identity", "quote"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-provider-admission-input.v12"},
    "status": {"const": "PENDING_LIVE_PROVIDER"},
    "template_file_sha256": {"$ref": "#/$defs/hash"},
    "template_sha256": {"$ref": "#/$defs/hash"},
    "observed_at_utc": {"$ref": "#/$defs/utc"},
    "provider_identity": {"$ref": "#/$defs/provider_identity"},
    "runtime_identity": {"$ref": "#/$defs/runtime_identity"},
    "quote": {"$ref": "#/$defs/quote"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "provider_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_label", "instance_identity_sha256", "observed_at_utc", "gpu_uuid_set_sha256", "gpu_count", "gpu_model", "vram_mib_each", "cpu_count", "ram_bytes", "free_disk_bytes"],
      "properties": {
        "provider_label": {"const": "Vast"}, "instance_identity_sha256": {"$ref": "#/$defs/hash"}, "observed_at_utc": {"$ref": "#/$defs/utc"}, "gpu_uuid_set_sha256": {"$ref": "#/$defs/hash"},
        "gpu_count": {"const": 4}, "gpu_model": {"const": "NVIDIA GeForce RTX 3090"}, "vram_mib_each": {"type": "integer", "minimum": 23000, "maximum": 25000}, "cpu_count": {"type": "integer", "minimum": 16}, "ram_bytes": {"type": "integer", "minimum": 68719476736}, "free_disk_bytes": {"type": "integer", "minimum": 268435456000}
      }
    },
    "runtime_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["image_reference", "image_manifest_digest", "platform", "python", "torch", "cuda"],
      "properties": {
        "image_reference": {"const": "pytorch/pytorch:2.6.0-cuda11.8-cudnn9-runtime"}, "image_manifest_digest": {"const": "sha256:2428b92ebbaeceba5572b98c18c8a94e43162bead6e88588ad54471147c58a20"}, "platform": {"const": "linux/amd64"}, "python": {"const": "3.11"}, "torch": {"const": "2.6.0+cu118"}, "cuda": {"const": "11.8"}
      }
    },
    "quote": {
      "type": "object", "additionalProperties": false,
      "required": ["quote_observed_at_utc", "compute_hourly_rate_usd", "billing_granularity_seconds", "minimum_billable_seconds", "storage_fee_usd", "network_fee_usd", "platform_or_other_fee_usd", "tax_or_surcharge_usd", "owner_ttl_hours", "worst_case_total_charge_usd", "quote_receipt_sha256"],
      "properties": {
        "quote_observed_at_utc": {"$ref": "#/$defs/utc"}, "compute_hourly_rate_usd": {"$ref": "#/$defs/nonnegative"}, "billing_granularity_seconds": {"type": "integer", "minimum": 1}, "minimum_billable_seconds": {"type": "integer", "minimum": 1}, "storage_fee_usd": {"$ref": "#/$defs/nonnegative"}, "network_fee_usd": {"$ref": "#/$defs/nonnegative"}, "platform_or_other_fee_usd": {"$ref": "#/$defs/nonnegative"}, "tax_or_surcharge_usd": {"$ref": "#/$defs/nonnegative"}, "owner_ttl_hours": {"const": 6}, "worst_case_total_charge_usd": {"$ref": "#/$defs/nonnegative"}, "quote_receipt_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "nonnegative": {"type": "number", "minimum": 0}
  }
}
