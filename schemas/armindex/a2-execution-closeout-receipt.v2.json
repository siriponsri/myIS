{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:a2-execution-closeout-receipt:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "attempt_id", "status", "evidence_class", "amendment_sha256", "candidate_count", "matched_candidate_count", "conditional_reserve_candidate_count", "measured_candidate_count", "dormant_conditional_reserve_count", "failed_candidate_count", "primary_winner_receipt_sha256s", "diagnostic_no_winner_receipt_sha256s", "primary_improvement_proofs", "candidate_result_set_sha256", "safe_return_receipt_sha256", "terminal_checkpoint_sha256", "aggregate_accounting_summary_sha256", "dormant_provenance_repair_manifest_file_sha256", "worker_reap_summary_sha256", "budget_cap_summary_sha256", "whole_workload_total_usd", "forward_hard_stop_usd", "workers_reaped", "protected_scan_passed", "diagnostic_non_advancing_arms", "primary_advancement_arms", "claim_evidence_pointers", "freeze_bindings", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a2-execution-closeout-receipt.v2"},
    "receipt_id": {"pattern": "^a2-[a-z0-9-]+-execution-closeout-v2$"},
    "attempt_id": {"pattern": "^a2-[a-z0-9-]{7,63}$"},
    "status": {"const": "PASS_A2_EXECUTION_CLOSEOUT"},
    "evidence_class": {"const": "measured_development_aggregate"},
    "amendment_sha256": {"$ref": "#/$defs/hash"},
    "candidate_count": {"const": 52},
    "matched_candidate_count": {"const": 40},
    "conditional_reserve_candidate_count": {"const": 12},
    "measured_candidate_count": {"const": 44},
    "dormant_conditional_reserve_count": {"const": 8},
    "failed_candidate_count": {"const": 0},
    "primary_winner_receipt_sha256s": {"$ref": "#/$defs/primaryHashes"},
    "diagnostic_no_winner_receipt_sha256s": {"$ref": "#/$defs/diagnosticHashes"},
    "primary_improvement_proofs": {"$ref": "#/$defs/improvementProofs"},
    "candidate_result_set_sha256": {"$ref": "#/$defs/hash"},
    "safe_return_receipt_sha256": {"$ref": "#/$defs/hash"},
    "terminal_checkpoint_sha256": {"$ref": "#/$defs/hash"},
    "aggregate_accounting_summary_sha256": {"$ref": "#/$defs/hash"},
    "dormant_provenance_repair_manifest_file_sha256": {"$ref": "#/$defs/hash"},
    "worker_reap_summary_sha256": {"$ref": "#/$defs/hash"},
    "budget_cap_summary_sha256": {"$ref": "#/$defs/hash"},
    "whole_workload_total_usd": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "forward_hard_stop_usd": {"const": "60"},
    "workers_reaped": {"const": true},
    "protected_scan_passed": {"const": true},
    "diagnostic_non_advancing_arms": {"const": ["ARM-01", "ARM-02"]},
    "primary_advancement_arms": {"const": ["ARM-03", "ARM-05", "ARM-04"]},
    "claim_evidence_pointers": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}},
    "freeze_bindings": {"$ref": "#/$defs/freeze"},
    "receipt_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "primaryHashes": {"type": "object", "additionalProperties": false, "required": ["ARM-03", "ARM-04", "ARM-05"], "properties": {"ARM-03": {"$ref": "#/$defs/hash"}, "ARM-04": {"$ref": "#/$defs/hash"}, "ARM-05": {"$ref": "#/$defs/hash"}}},
    "diagnosticHashes": {"type": "object", "additionalProperties": false, "required": ["ARM-01", "ARM-02"], "properties": {"ARM-01": {"$ref": "#/$defs/hash"}, "ARM-02": {"$ref": "#/$defs/hash"}}},
    "improvementProofs": {"type": "object", "additionalProperties": false, "required": ["ARM-03", "ARM-04", "ARM-05"], "properties": {"ARM-03": {"$ref": "#/$defs/improvementProof"}, "ARM-04": {"$ref": "#/$defs/improvementProof"}, "ARM-05": {"$ref": "#/$defs/improvementProof"}}},
    "improvementProof": {"type": "object", "additionalProperties": false, "required": ["winner_candidate_id", "winner_primary_metric", "frozen_a1_incumbent_candidate_id", "frozen_a1_primary_metric", "strict_primary_improvement", "a1_comparison"], "properties": {"winner_candidate_id": {"type": "string", "pattern": "^a2-arm-0[3-5]-(matched|reserve)-b[1-3]-(exploit|matched-ablation|orthogonal|diversity)$"}, "winner_primary_metric": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}, "frozen_a1_incumbent_candidate_id": {"type": "string", "minLength": 1}, "frozen_a1_primary_metric": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}, "strict_primary_improvement": {"type": "boolean"}, "a1_comparison": {"enum": ["STRICT_IMPROVEMENT", "NO_STRICT_IMPROVEMENT"]}}},
    "freeze": {"type": "object", "additionalProperties": false, "required": ["manifest_sha256", "freeze_receipt_sha256", "lock_sha256"], "properties": {"manifest_sha256": {"$ref": "#/$defs/hash"}, "freeze_receipt_sha256": {"$ref": "#/$defs/hash"}, "lock_sha256": {"$ref": "#/$defs/hash"}}}
  }
}
