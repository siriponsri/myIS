{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myis.local/schemas/armindex/a1.2-whole-workload-budget-admission-result.v12.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "revision_id", "status", "claim_boundary",
    "admitted", "admission_file_sha256", "input_sha256", "quote_age_seconds",
    "billable_seconds", "worst_case_ttl_charge_usd", "projected_spend_usd",
    "hard_stops_usd", "failure_reasons", "provider_contact_allowed",
    "launch_allowed", "adopted_for_execution", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-whole-workload-budget-admission-result.v12"},
    "receipt_id": {"pattern": "^a1\\.2-whole-workload-budget-admission-[a-z0-9._-]+-v12$"},
    "revision_id": {"const": "a1.2-whole-workload-budget-admission-v12"},
    "status": {"enum": ["PASS_BUDGET_ADMISSION_LOCKED", "BLOCKED_BUDGET"]},
    "claim_boundary": {"const": "Local-only whole-workload budget arithmetic over an Owner-supplied sanitized quote; no provider contact, reservation, launch, adoption, measured retrieval, or scientific execution."},
    "admitted": {"type": "boolean"},
    "admission_file_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "input_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "quote_age_seconds": {"type": "number", "minimum": 0},
    "billable_seconds": {"type": "integer", "minimum": 1},
    "worst_case_ttl_charge_usd": {"type": "number", "minimum": 0},
    "projected_spend_usd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common_screen", "a1_total", "campaign"],
      "properties": {
        "common_screen": {"type": "number", "minimum": 0},
        "a1_total": {"type": "number", "minimum": 0},
        "campaign": {"type": "number", "minimum": 0}
      }
    },
    "hard_stops_usd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common_screen", "a1_total", "campaign"],
      "properties": {
        "common_screen": {"const": 18},
        "a1_total": {"const": 23},
        "campaign": {"const": 100}
      }
    },
    "failure_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provider_contact_allowed": {"const": false},
    "launch_allowed": {"const": false},
    "adopted_for_execution": {"const": false},
    "receipt_sha256": {"pattern": "^[a-f0-9]{64}$"}
  }
}
