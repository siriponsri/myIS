{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:brain-memory:v1",
  "title": "ArmIndex pointer-first Research Brain memory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "memory_id", "campaign_id", "phase_id", "task_id", "research_flow_id", "memory_type", "title", "interpretation", "source_uri", "source_sha256", "evidence_ids", "arm_ids", "model_ids", "representation_program_ids", "harness_ids", "created_at", "reviewed_at", "status", "supersedes", "superseded_by", "evidence_role", "expires_at"],
  "properties": {
    "schema_version": {"const": "myis.armindex-brain-memory.v1"},
    "memory_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
    "campaign_id": {"type": "string", "minLength": 1},
    "phase_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "research_flow_id": {"type": ["string", "null"]},
    "memory_type": {"enum": ["decision", "evidence", "lesson", "failed_attempt", "active_context", "research_question", "arm_finding", "representation_finding", "harness_finding", "production_finding"]},
    "title": {"type": "string", "minLength": 1},
    "interpretation": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "arm_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "model_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "representation_program_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "harness_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "historical", "superseded", "expired"]},
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]},
    "evidence_role": {"enum": ["engineering", "fixture", "development", "selection", "confirmation", "historical"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
