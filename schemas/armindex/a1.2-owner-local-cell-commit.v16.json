{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myis.armindex-a1.2-owner-local-cell-commit.v16",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "attempt_id", "cell_id", "status", "aggregate_safe", "manifest_sha256", "binding_sha256", "cell_receipt_sha256", "ranking_file_sha256", "ranking_set_sha256", "metrics_sha256", "commit_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-a1.2-owner-local-cell-commit.v16"},
    "receipt_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "cell_id": {"type": "string", "pattern": "^ARM-0[1-5]--P0[0-4]-(?:TAC-DOC|TA-DOC|CLAIM1|PASSAGE|SECTION-MULTIVIEW)$"},
    "status": {"const": "PASS"},
    "aggregate_safe": {"const": true},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "binding_sha256": {"$ref": "#/$defs/sha256"},
    "cell_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "ranking_file_sha256": {"$ref": "#/$defs/sha256"},
    "ranking_set_sha256": {"$ref": "#/$defs/sha256"},
    "metrics_sha256": {"$ref": "#/$defs/sha256"},
    "commit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
