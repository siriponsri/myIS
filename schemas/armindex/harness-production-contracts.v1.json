{
  "$defs": {
    "HarnessAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "search",
            "escalate",
            "stop",
            "fallback",
            "abstain"
          ],
          "title": "Action",
          "type": "string"
        },
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "arm_id": {
          "enum": [
            "ARM-01",
            "ARM-02",
            "ARM-03",
            "ARM-04",
            "ARM-05"
          ],
          "title": "Arm Id",
          "type": "string"
        },
        "commercial_status": {
          "enum": [
            "commercial_capable",
            "research_non_commercial",
            "mixed",
            "not_applicable"
          ],
          "title": "Commercial Status",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "depth": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Depth",
          "type": "integer"
        },
        "evidence_class": {
          "enum": [
            "synthetic_fixture",
            "engineering",
            "aggregate_evidence",
            "contract_only"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "harness_id": {
          "minLength": 1,
          "title": "Harness Id",
          "type": "string"
        },
        "previous_action_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Action Sha256"
        },
        "protected_data_accessed": {
          "const": false,
          "title": "Protected Data Accessed",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "myis.armindex-harness-action.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_authority": {
          "title": "Scientific Authority",
          "type": "boolean"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "contract_id",
        "evidence_class",
        "scientific_authority",
        "commercial_status",
        "protected_data_accessed",
        "contract_sha256",
        "schema_version",
        "action_id",
        "harness_id",
        "request_id",
        "sequence",
        "arm_id",
        "action",
        "depth",
        "reason"
      ],
      "title": "HarnessAction",
      "type": "object"
    },
    "HarnessConfiguration": {
      "additionalProperties": false,
      "properties": {
        "arm_ids": {
          "items": {
            "enum": [
              "ARM-01",
              "ARM-02",
              "ARM-03",
              "ARM-04",
              "ARM-05"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Arm Ids",
          "type": "array"
        },
        "cache_policy": {
          "enum": [
            "disabled",
            "read_only",
            "bounded"
          ],
          "title": "Cache Policy",
          "type": "string"
        },
        "commercial_status": {
          "enum": [
            "commercial_capable",
            "research_non_commercial",
            "mixed",
            "not_applicable"
          ],
          "title": "Commercial Status",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "early_stop": {
          "additionalProperties": true,
          "title": "Early Stop",
          "type": "object"
        },
        "evidence_class": {
          "enum": [
            "synthetic_fixture",
            "engineering",
            "aggregate_evidence",
            "contract_only"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "execution": {
          "enum": [
            "parallel",
            "sequential"
          ],
          "title": "Execution",
          "type": "string"
        },
        "fusion_configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fusion Configuration Sha256",
          "type": "string"
        },
        "harness_id": {
          "minLength": 1,
          "title": "Harness Id",
          "type": "string"
        },
        "initial_depth_by_arm": {
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1,
          "title": "Initial Depth By Arm",
          "type": "object"
        },
        "invocation_order": {
          "items": {
            "enum": [
              "ARM-01",
              "ARM-02",
              "ARM-03",
              "ARM-04",
              "ARM-05"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Invocation Order",
          "type": "array"
        },
        "latency_profile": {
          "enum": [
            "FAST",
            "BALANCED",
            "DEEP"
          ],
          "title": "Latency Profile",
          "type": "string"
        },
        "maximum_depth_by_arm": {
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1,
          "title": "Maximum Depth By Arm",
          "type": "object"
        },
        "protected_data_accessed": {
          "const": false,
          "title": "Protected Data Accessed",
          "type": "boolean"
        },
        "runtime_features": {
          "items": {
            "enum": [
              "query_length",
              "token_count",
              "script",
              "language_hint",
              "system_load",
              "cache_state"
            ],
            "type": "string"
          },
          "title": "Runtime Features",
          "type": "array"
        },
        "schema_version": {
          "const": "myis.armindex-harness-configuration.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_authority": {
          "title": "Scientific Authority",
          "type": "boolean"
        }
      },
      "required": [
        "contract_id",
        "evidence_class",
        "scientific_authority",
        "commercial_status",
        "protected_data_accessed",
        "contract_sha256",
        "schema_version",
        "harness_id",
        "arm_ids",
        "invocation_order",
        "execution",
        "initial_depth_by_arm",
        "maximum_depth_by_arm",
        "fusion_configuration_sha256",
        "early_stop",
        "cache_policy",
        "latency_profile",
        "runtime_features"
      ],
      "title": "HarnessConfiguration",
      "type": "object"
    },
    "ProductionProfile": {
      "additionalProperties": false,
      "properties": {
        "arm_ids": {
          "items": {
            "enum": [
              "ARM-01",
              "ARM-02",
              "ARM-03",
              "ARM-04",
              "ARM-05"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Arm Ids",
          "type": "array"
        },
        "commercial_only": {
          "title": "Commercial Only",
          "type": "boolean"
        },
        "commercial_status": {
          "enum": [
            "commercial_capable",
            "research_non_commercial",
            "mixed",
            "not_applicable"
          ],
          "title": "Commercial Status",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "synthetic_fixture",
            "engineering",
            "aggregate_evidence",
            "contract_only"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "harness_configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Harness Configuration Sha256",
          "type": "string"
        },
        "maximum_candidate_depth": {
          "maximum": 2000,
          "minimum": 1,
          "title": "Maximum Candidate Depth",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "synchronous",
            "asynchronous"
          ],
          "title": "Mode",
          "type": "string"
        },
        "profile_id": {
          "enum": [
            "FAST",
            "BALANCED",
            "DEEP"
          ],
          "title": "Profile Id",
          "type": "string"
        },
        "protected_data_accessed": {
          "const": false,
          "title": "Protected Data Accessed",
          "type": "boolean"
        },
        "readiness": {
          "const": "contract_only",
          "title": "Readiness",
          "type": "string"
        },
        "schema_version": {
          "const": "myis.armindex-production-profile.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_authority": {
          "title": "Scientific Authority",
          "type": "boolean"
        }
      },
      "required": [
        "contract_id",
        "evidence_class",
        "scientific_authority",
        "commercial_status",
        "protected_data_accessed",
        "contract_sha256",
        "schema_version",
        "profile_id",
        "harness_configuration_sha256",
        "arm_ids",
        "mode",
        "maximum_candidate_depth",
        "commercial_only",
        "readiness"
      ],
      "title": "ProductionProfile",
      "type": "object"
    }
  },
  "$id": "urn:myis:armindex:harness-production-contracts:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/HarnessConfiguration"
    },
    {
      "$ref": "#/$defs/HarnessAction"
    },
    {
      "$ref": "#/$defs/ProductionProfile"
    }
  ],
  "title": "ArmIndex harness production contracts.v1"
}
