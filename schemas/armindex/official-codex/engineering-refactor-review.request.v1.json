{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:official-codex:engineering-refactor-review-request:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "failure_summary", "allowed_files", "frozen_scientific_semantics", "contains_metrics", "contains_outcomes", "protected_data_accessed", "measured_execution_performed"],
  "properties": {
    "schema_version": {"type": "string", "const": "myis.armindex-engineering-refactor-review-request.v1"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "failure_summary": {"type": "string", "minLength": 8, "maxLength": 4000},
    "allowed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"}},
    "frozen_scientific_semantics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "contains_metrics": {"type": "boolean", "const": false},
    "contains_outcomes": {"type": "boolean", "const": false},
    "protected_data_accessed": {"type": "boolean", "const": false},
    "measured_execution_performed": {"type": "boolean", "const": false}
  }
}
