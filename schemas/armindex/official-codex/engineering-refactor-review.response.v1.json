{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:official-codex:engineering-refactor-review-response:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "verdict", "diagnosis", "required_engineering_changes", "forbidden_scientific_changes", "protected_data_accessed", "measured_execution_performed"],
  "properties": {
    "schema_version": {"type": "string", "const": "myis.armindex-engineering-refactor-review-response.v1"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "verdict": {"type": "string", "enum": ["accept", "revise", "reject"]},
    "diagnosis": {"type": "string", "minLength": 8, "maxLength": 1200},
    "required_engineering_changes": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 400}},
    "forbidden_scientific_changes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 400}},
    "protected_data_accessed": {"type": "boolean", "const": false},
    "measured_execution_performed": {"type": "boolean", "const": false}
  }
}
