{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:official-codex:representation-review-response:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "arm_id", "tier", "batch_id", "reviews", "protected_data_accessed", "measured_execution_performed"],
  "properties": {
    "schema_version": {"type": "string", "const": "myis.armindex-representation-review-response.v1"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "arm_id": {"type": "string", "enum": ["ARM-01", "ARM-02", "ARM-03", "ARM-04", "ARM-05"]},
    "tier": {"type": "string", "enum": ["matched", "conditional_reserve"]},
    "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "reviews": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/review"}},
    "protected_data_accessed": {"type": "boolean", "const": false},
    "measured_execution_performed": {"type": "boolean", "const": false}
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "verdict", "falsifiable", "role_fit", "duplicate_free", "protected_boundary_safe", "arm_compatible", "deterministic", "publication_interpretable", "rationale", "required_changes"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^a2-arm-[0-9]{2}-(matched|reserve)-b[1-3]-(exploit|matched-ablation|orthogonal|diversity)$"},
        "verdict": {"type": "string", "enum": ["accept", "revise", "reject"]},
        "falsifiable": {"type": "boolean"},
        "role_fit": {"type": "boolean"},
        "duplicate_free": {"type": "boolean"},
        "protected_boundary_safe": {"type": "boolean"},
        "arm_compatible": {"type": "boolean"},
        "deterministic": {"type": "boolean"},
        "publication_interpretable": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 8, "maxLength": 800},
        "required_changes": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 300}}
      }
    }
  }
}
