{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:official-codex:representation-review-request:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "arm_id", "tier", "batch_id", "review_round", "arm_context", "candidates", "review_criteria", "frozen_bindings", "protected_data_accessed", "measured_execution_performed"],
  "properties": {
    "schema_version": {"type": "string", "const": "myis.armindex-representation-review-request.v1"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "arm_id": {"type": "string", "enum": ["ARM-01", "ARM-02", "ARM-03", "ARM-04", "ARM-05"]},
    "tier": {"type": "string", "enum": ["matched", "conditional_reserve"]},
    "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "review_round": {"type": "integer", "minimum": 0, "maximum": 4},
    "arm_context": {"$ref": "#/$defs/armContext"},
    "candidates": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/candidate"}},
    "review_criteria": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "string", "enum": ["falsifiability", "role_fit", "duplication", "protected_boundary", "arm_compatibility", "determinism", "publication_interpretability"]}},
    "frozen_bindings": {"$ref": "#/$defs/frozenBindings"},
    "protected_data_accessed": {"type": "boolean", "const": false},
    "measured_execution_performed": {"type": "boolean", "const": false}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "role", "hypothesis", "declared_axis", "program", "expected_effect", "failure_risk"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^a2-arm-[0-9]{2}-(matched|reserve)-b[1-3]-(exploit|matched-ablation|orthogonal|diversity)$"},
        "role": {"type": "string", "enum": ["exploit", "matched_ablation", "orthogonal", "diversity"]},
        "hypothesis": {"type": "string", "minLength": 12, "maxLength": 800},
        "declared_axis": {"type": "string", "enum": ["field_selection", "field_order", "field_labeling", "unitization", "normalization", "duplicate_policy", "family_aggregation"]},
        "program": {"$ref": "#/$defs/program"},
        "expected_effect": {"type": "string", "minLength": 8, "maxLength": 500},
        "failure_risk": {"type": "string", "minLength": 8, "maxLength": 500}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_fields", "field_order", "field_labels", "unitization", "normalization", "duplicate_policy", "family_aggregation"],
      "properties": {
        "source_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["title", "abstract", "claims_text"]}},
        "field_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["title", "abstract", "claims_text"]}},
        "field_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "abstract", "claims_text"],
          "properties": {
            "title": {"type": "string", "maxLength": 40},
            "abstract": {"type": "string", "maxLength": 40},
            "claims_text": {"type": "string", "maxLength": 40}
          }
        },
        "unitization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "logical_size", "overlap"],
          "properties": {
            "kind": {"type": "string", "enum": ["family", "field", "section", "passage"]},
            "logical_size": {"anyOf": [{"type": "integer", "minimum": 32, "maximum": 2048}, {"type": "null"}]},
            "overlap": {"type": "integer", "minimum": 0, "maximum": 512}
          }
        },
        "normalization": {"type": "string", "enum": ["unicode_nfkc_whitespace", "unicode_nfkc_whitespace_lower"]},
        "duplicate_policy": {"type": "string", "enum": ["content_hash_first", "preserve_all"]},
        "family_aggregation": {"type": "string", "enum": ["maxp", "avg_top3", "single_unit"]}
      }
    },
    "armContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "method", "effective_max_input_tokens", "diagnostic_non_advancing", "advancement_eligible"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "effective_max_input_tokens": {"type": "integer", "minimum": 128},
        "diagnostic_non_advancing": {"type": "boolean"},
        "advancement_eligible": {"type": "boolean"}
      }
    },
    "frozenBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_sha256", "a1_terminal_receipt_sha256", "promotion_receipt_sha256", "representation_schema_sha256", "evaluator_sha256", "primary_metric"],
      "properties": {
        "campaign_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "a1_terminal_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "promotion_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "representation_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evaluator_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "primary_metric": {"type": "string", "const": "recall_at_100/out"}
      }
    }
  }
}
