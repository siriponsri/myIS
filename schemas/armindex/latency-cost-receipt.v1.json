{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:latency-cost-receipt:v1",
  "title": "ArmIndex aggregate latency and cost receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "arm_ids", "sample_count", "latency_ms", "throughput_qps", "cost_per_query_usd", "charged_usd", "index_size_bytes", "ram_bytes", "vram_bytes", "manifest_sha256", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "myis.armindex-latency-cost-receipt.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "arm_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "sample_count": {"type": "integer", "minimum": 1},
    "latency_ms": {"type": "object", "additionalProperties": false, "required": ["p50", "p95", "p99"], "properties": {"p50": {"type": "number", "minimum": 0}, "p95": {"type": "number", "minimum": 0}, "p99": {"type": "number", "minimum": 0}}},
    "throughput_qps": {"type": "number", "minimum": 0},
    "cost_per_query_usd": {"type": "number", "minimum": 0},
    "charged_usd": {"type": "number", "minimum": 0},
    "index_size_bytes": {"type": "integer", "minimum": 0},
    "ram_bytes": {"type": "integer", "minimum": 0},
    "vram_bytes": {"type": "integer", "minimum": 0},
    "manifest_sha256": {"$ref": "#/$defs/sha"},
    "receipt_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
