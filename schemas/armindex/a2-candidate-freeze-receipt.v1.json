{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:a2-candidate-freeze-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "campaign_id", "phase_id", "task_id", "revision_id", "generation_attempt_id", "status", "manifest_sha256", "manifest_file_sha256", "lock_sha256", "candidate_count", "matched_candidate_count", "conditional_reserve_candidate_count", "accepted_candidate_count", "compile_twice_candidate_count", "diagnostic_non_advancing_arms", "primary_advancement_arms", "official_model", "official_reasoning_effort", "official_sdk_version", "official_cli_version", "official_provider", "source_commit", "source_tree", "protected_data_accessed", "rep_dev_accessed_for_measurement", "measured_a2_started", "gpu_work_performed", "provider_admission_performed", "provider_execution_adoption_performed", "selection_accesses", "final_accesses", "harness_dev_accesses", "receipt_sha256"],
  "properties": {
    "schema_version": {"type": "string", "const": "myis.armindex-a2-candidate-freeze-receipt.v1"},
    "receipt_id": {"type": "string", "const": "a2-five-arm-candidate-freeze-v1"},
    "campaign_id": {"type": "string", "const": "armindex-multiretriever-v2"},
    "phase_id": {"type": "string", "const": "A2_PER_ARM_AUTOINDEX"},
    "task_id": {"type": "string", "const": "OFFICIAL_CODEX_BRIDGE_AND_CANDIDATE_FREEZE"},
    "revision_id": {"type": "string", "const": "a2-five-arm-premeasurement-freeze-v1"},
    "generation_attempt_id": {"type": "string", "pattern": "^a2freeze-[0-9]{8}t[0-9]{6}z$"},
    "status": {"type": "string", "const": "PASS_FIVE_ARM_CANDIDATE_FREEZE"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_file_sha256": {"$ref": "#/$defs/sha256"},
    "lock_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_count": {"type": "integer", "const": 52},
    "matched_candidate_count": {"type": "integer", "const": 40},
    "conditional_reserve_candidate_count": {"type": "integer", "const": 12},
    "accepted_candidate_count": {"type": "integer", "const": 52},
    "compile_twice_candidate_count": {"type": "integer", "const": 52},
    "diagnostic_non_advancing_arms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "enum": ["ARM-01", "ARM-02"]}},
    "primary_advancement_arms": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "enum": ["ARM-03", "ARM-05", "ARM-04"]}},
    "official_model": {"type": "string", "const": "gpt-5.6-sol"},
    "official_reasoning_effort": {"type": "string", "const": "high"},
    "official_sdk_version": {"type": "string", "const": "0.144.4"},
    "official_cli_version": {"type": "string", "const": "0.144.4"},
    "official_provider": {"type": "string", "const": "openai"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "source_tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "protected_data_accessed": {"type": "boolean", "const": false},
    "rep_dev_accessed_for_measurement": {"type": "boolean", "const": false},
    "measured_a2_started": {"type": "boolean", "const": false},
    "gpu_work_performed": {"type": "boolean", "const": false},
    "provider_admission_performed": {"type": "boolean", "const": false},
    "provider_execution_adoption_performed": {"type": "boolean", "const": false},
    "selection_accesses": {"type": "integer", "const": 0},
    "final_accesses": {"type": "integer", "const": 0},
    "harness_dev_accesses": {"type": "integer", "const": 0},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
