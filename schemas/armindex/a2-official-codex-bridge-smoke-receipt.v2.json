{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:armindex:a2-official-codex-bridge-smoke-receipt:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "campaign_id", "phase_id", "task_id", "status", "evidence_class", "scientific_authority", "request_id", "operation", "verdict", "event_sha256", "event_store_pointer", "bridge_config_sha256", "bridge_config_file_sha256", "source_commit", "source_tree", "identity", "focused_test_count", "retry_count", "post_round_credit", "parent_environment_mutated", "paid_api_key_used", "protected_data_accessed", "measured_execution_performed", "provider_admission_performed", "provider_execution_adoption_performed", "smoke_at_utc", "credit_checked_at_utc", "receipt_sha256"],
  "properties": {
    "schema_version": {"type": "string", "const": "myis.armindex-a2-official-codex-bridge-smoke-receipt.v2"},
    "receipt_id": {"type": "string", "const": "a2-official-codex-bridge-final-smoke-v2"},
    "campaign_id": {"type": "string", "const": "armindex-multiretriever-v2"},
    "phase_id": {"type": "string", "const": "A2_PER_ARM_AUTOINDEX"},
    "task_id": {"type": "string", "const": "OFFICIAL_CODEX_BRIDGE_AND_CANDIDATE_FREEZE"},
    "status": {"type": "string", "const": "PASS_OFFICIAL_CODEX_BRIDGE_SMOKE_AND_CREDIT"},
    "evidence_class": {"type": "string", "const": "engineering_validation"},
    "scientific_authority": {"type": "boolean", "const": false},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "operation": {"type": "string", "const": "engineering_refactor_review"},
    "verdict": {"type": "string", "const": "accept"},
    "event_sha256": {"$ref": "#/$defs/sha256"},
    "event_store_pointer": {"type": "string", "pattern": "^owner-local://official-codex/"},
    "bridge_config_sha256": {"$ref": "#/$defs/sha256"},
    "bridge_config_file_sha256": {"$ref": "#/$defs/sha256"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "source_tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk_version", "cli_version", "runtime_user_agent", "model_name", "model_provider", "reasoning_effort"],
      "properties": {
        "sdk_version": {"type": "string", "const": "0.144.4"},
        "cli_version": {"type": "string", "const": "0.144.4"},
        "runtime_user_agent": {"type": "string", "minLength": 1},
        "model_name": {"type": "string", "const": "gpt-5.6-sol"},
        "model_provider": {"type": "string", "const": "openai"},
        "reasoning_effort": {"type": "string", "const": "high"}
      }
    },
    "focused_test_count": {"type": "integer", "minimum": 24},
    "retry_count": {"type": "integer", "const": 0},
    "post_round_credit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "snapshot_sha256", "snapshot_pointer", "model_name", "plan_type", "used_percent", "remaining_percent", "window_duration_mins", "resets_at_utc", "rate_limit_reached_type", "reset_credit_available_count", "reset_credit_consumed", "limit_reached"],
      "properties": {
        "checkpoint_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_pointer": {"type": "string", "pattern": "^owner-local://official-codex/"},
        "model_name": {"type": "string", "const": "gpt-5.6-sol"},
        "plan_type": {"type": "string", "minLength": 1},
        "used_percent": {"type": "integer", "minimum": 0, "maximum": 99},
        "remaining_percent": {"type": "integer", "minimum": 1, "maximum": 100},
        "window_duration_mins": {"type": "integer", "minimum": 1},
        "resets_at_utc": {"$ref": "#/$defs/timestamp"},
        "rate_limit_reached_type": {"type": "null"},
        "reset_credit_available_count": {"type": "integer", "minimum": 0},
        "reset_credit_consumed": {"type": "boolean", "const": false},
        "limit_reached": {"type": "boolean", "const": false}
      }
    },
    "parent_environment_mutated": {"type": "boolean", "const": false},
    "paid_api_key_used": {"type": "boolean", "const": false},
    "protected_data_accessed": {"type": "boolean", "const": false},
    "measured_execution_performed": {"type": "boolean", "const": false},
    "provider_admission_performed": {"type": "boolean", "const": false},
    "provider_execution_adoption_performed": {"type": "boolean", "const": false},
    "smoke_at_utc": {"$ref": "#/$defs/timestamp"},
    "credit_checked_at_utc": {"$ref": "#/$defs/timestamp"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
