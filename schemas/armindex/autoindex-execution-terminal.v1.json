{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myis.armindex-autoindex-execution-terminal.v1",
  "title": "ArmIndex AutoIndex execution terminal receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "arm_id",
    "terminal_state",
    "winner_candidate_id",
    "winner_program_sha256",
    "primary_metric",
    "completed_batches",
    "strict_improvements",
    "frozen_bindings_sha256",
    "evidence_ids",
    "protected_data_accessed",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "myis.armindex-autoindex-execution-terminal.v1"
    },
    "arm_id": {
      "enum": ["ARM-01", "ARM-02", "ARM-03", "ARM-04", "ARM-05"]
    },
    "terminal_state": {
      "enum": [
        "STOP_WITH_EVIDENCE_FLAT_REPRESENTATION_SURFACE",
        "FREEZE_ARM_PROGRAM"
      ]
    },
    "winner_candidate_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "winner_program_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "primary_metric": {
      "type": "string",
      "pattern": "^[+-]?[0-9]+\\.[0-9]{12}$"
    },
    "completed_batches": {
      "type": "integer",
      "minimum": 2,
      "maximum": 3
    },
    "strict_improvements": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "frozen_bindings_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protected_data_accessed": {
      "const": false
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
