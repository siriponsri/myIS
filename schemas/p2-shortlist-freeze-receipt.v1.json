{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:p2-shortlist-freeze-receipt:v1",
  "title": "myIS P2 immutable shortlist freeze receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "phase_id", "campaign_revision", "budget_profile_id", "budget_profile_sha256", "baseline_commitment_sha256", "baseline_reproduction_receipt_sha256", "candidate_ids", "candidate_spec_hashes", "compiler_sha256", "config_sha256", "retriever_sha256", "evaluator_sha256", "selection_rule", "selection_exposure_count", "status", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "myis.p2-shortlist-freeze-receipt.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "phase_id": {"const": "P2_SCOPE_DEVELOPMENT"},
    "campaign_revision": {"type": "string", "minLength": 1},
    "budget_profile_id": {"type": "string", "pattern": "^p2-r1-primary-v[0-9]+$"},
    "budget_profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_commitment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_reproduction_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_ids": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "candidate_spec_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "compiler_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retriever_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluator_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selection_rule": {"const": "strictly_greater_reject_ties"},
    "selection_exposure_count": {"const": 0},
    "status": {"const": "validated_immutable"},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
