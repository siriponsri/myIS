{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:p2-candidate-ledger:v1",
  "title": "myIS P2 candidate ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "campaign_revision", "budget_profile_id", "budget_profile_sha256", "baseline_commitment_sha256", "candidate_count", "candidates", "iterations", "ledger_sha256"],
  "properties": {
    "schema_version": {"const": "myis.p2-candidate-ledger.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "campaign_revision": {"type": "string", "minLength": 1},
    "budget_profile_id": {"type": "string", "pattern": "^p2-r1-primary-v[0-9]+$"},
    "budget_profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_commitment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stop_reason": {"enum": ["wall_clock_exhausted", "development_impact_gate", "no_grounded_hypotheses", "owner_stop_after_checkpoint"]},
    "candidate_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "candidates": {
      "type": "array", "maxItems": 32, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "arm", "class", "iteration", "spec_sha256", "status", "train_metric", "index_build_count", "selection_eligible"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "arm": {"enum": ["R0", "R0-W", "R1"]},
          "class": {"enum": ["frozen_control", "preregistered_patent", "adaptive_autoindex"]},
          "iteration": {"type": "integer", "minimum": 0, "maximum": 5},
          "spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "compiler_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "retriever_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "evaluator_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["train_complete", "rejected", "frozen"]},
          "train_metric": {"$ref": "urn:myis:research:schema:p2-train-metric:v1"},
          "index_build_count": {"type": "integer", "minimum": 0, "maximum": 32},
          "selection_eligible": {"type": "boolean"}
        }
      }
    },
    "iterations": {
      "type": "array", "minItems": 0, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["iteration", "candidate_ids", "best_metric", "status"],
        "properties": {
          "iteration": {"type": "integer", "minimum": 1, "maximum": 5},
          "candidate_ids": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "best_metric": {"$ref": "urn:myis:research:schema:p2-train-metric:v1"},
          "status": {"const": "completed"}
        }
      }
    },
    "ledger_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
