{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:observatory-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "evidence_class", "scientific_authority", "protected_data_accessed", "measured_execution", "real_counters", "registry_sha256", "package_sha256", "negative_checks", "receipt_sha256"],
  "properties": {"schema_version": {"const": "myis.observatory-receipt.v1"}, "fixture_id": {"type": "string"}, "evidence_class": {"const": "fixture"}, "scientific_authority": {"const": false}, "protected_data_accessed": {"const": false}, "measured_execution": {"const": false}, "real_counters": {"type": "object"}, "registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "negative_checks": {"type": "object"}, "mlflow_run_id": {"type": "string"}, "mlflow_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
