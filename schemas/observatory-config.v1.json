{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:observatory-config:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "config_id", "version", "content_sha256", "evidence_class", "scientific_authority", "claim_boundary", "record_sha256"],
  "properties": {
    "schema_version": {"const": "myis.observatory-config.v1"},
    "record_id": {"type": "string"}, "config_id": {"type": "string"}, "version": {"type": "string"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "cpu_only": {"type": "boolean"}, "paid_api": {"type": "boolean"},
    "evidence_class": {"type": "string"}, "scientific_authority": {"type": "boolean"}, "claim_boundary": {"type": "string"},
    "summary": {"type": "string"}, "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
