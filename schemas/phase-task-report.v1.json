{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:phase-task-report:v1",
  "title": "myIS phase and task report record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "report_type", "phase_id", "task_id",
    "status", "evidence_class", "scientific_authority", "claim_boundary",
    "generated_at", "generated_from_revision", "last_material_update",
    "git_commit", "objective", "starting_state", "input_bindings",
    "work_summary", "artifact_references", "metric_references", "result",
    "interpretation", "supported_claims", "unsupported_claims",
    "failure_recovery_references", "governance_status", "decision",
    "next_authorized_action", "evidence_links", "validation_status",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "myis.phase-task-report.v1"},
    "report_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "report_type": {"enum": ["phase", "task"]},
    "phase_id": {"enum": ["P0_FOUNDATION", "P1_CPU_BASELINE", "P2_SCOPE_DEVELOPMENT", "P3_FINAL", "P4_PUBLICATION"]},
    "task_id": {"type": ["string", "null"]},
    "status": {"enum": ["planned", "active", "blocked", "completed", "superseded"]},
    "evidence_class": {"type": "string", "minLength": 1},
    "scientific_authority": {"type": "boolean"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "generated_from_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "last_material_update": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "objective": {"type": "string", "minLength": 1},
    "starting_state": {"type": "object"},
    "input_bindings": {"type": "object"},
    "work_summary": {"type": "string", "minLength": 1},
    "artifact_references": {"type": "array", "items": {"type": "object"}},
    "metric_references": {"type": "array", "items": {"type": "object"}},
    "result": {"type": "object"},
    "interpretation": {"type": "string", "minLength": 1},
    "supported_claims": {"type": "array", "items": {"type": "object"}},
    "unsupported_claims": {"type": "array", "items": {"type": "string"}},
    "failure_recovery_references": {"type": "array", "items": {"type": "object"}},
    "governance_status": {"type": "object"},
    "decision": {"type": "object"},
    "next_authorized_action": {"type": "string", "minLength": 1},
    "evidence_links": {"type": "array", "items": {"type": "object"}},
    "validation_status": {"const": "validated"},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
