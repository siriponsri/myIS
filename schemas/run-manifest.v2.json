{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:run-manifest:v2",
  "title": "myIS immutable run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "experiment_id", "campaign_id", "status", "stage", "source", "data", "method", "resources", "metrics", "artifacts"],
  "properties": {
    "schema_version": {"const": "myis.run-manifest.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "campaign_id": {"const": "scope-autoindex-v1"},
    "status": {"enum": ["complete", "failed", "invalid", "superseded", "aggregate_pending"]},
    "stage": {"enum": ["fixture", "train", "selection", "transfer", "final", "report"]},
    "source": {"type": "object"},
    "data": {"type": "object"},
    "method": {"type": "object"},
    "resources": {"type": "object"},
    "metrics": {"type": "array"},
    "artifacts": {"type": "array"},
    "owner_local_receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  }
}
