{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:p1-package:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "status", "source_commit", "request_uri", "request_sha256", "receipt_uri", "receipt_sha256", "source_contract_sha256", "slots", "package_sha256"],
  "properties": {
    "schema_version": {"const": "myis.p1-package.v1"},
    "package_id": {"type": "string"},
    "status": {"const": "validated_structural"},
    "source_commit": {"pattern": "^[a-f0-9]{40,64}$"},
    "request_uri": {"type": "string"},
    "request_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "receipt_uri": {"type": "string"},
    "receipt_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "source_contract_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "slots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm", "split", "run_id", "manifest_uri", "manifest_sha256", "validation_report_uri", "validation_report_sha256"],
        "properties": {
          "arm": {"enum": ["R0", "R0-W"]},
          "split": {"enum": ["train", "selection"]},
          "run_id": {"type": "string", "minLength": 1},
          "manifest_uri": {"type": "string", "minLength": 1},
          "manifest_sha256": {"pattern": "^[a-f0-9]{64}$"},
          "validation_report_uri": {"type": "string", "minLength": 1},
          "validation_report_sha256": {"pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "package_sha256": {"pattern": "^[a-f0-9]{64}$"}
  }
}
