{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:observatory-decision:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "result_id", "status", "next_action", "evidence_class", "scientific_authority", "claim_boundary", "record_sha256"],
  "properties": {
    "schema_version": {"const": "myis.observatory-decision.v1"}, "record_id": {"type": "string"}, "result_id": {"type": "string"}, "status": {"type": "string"}, "next_action": {"type": "string"}, "summary": {"type": "string"}, "evidence_class": {"type": "string"}, "scientific_authority": {"type": "boolean"}, "claim_boundary": {"type": "string"}, "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
