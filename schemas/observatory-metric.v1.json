{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:observatory-metric:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "name", "cutoff", "direction", "data_role", "scope", "evidence_role", "value", "n", "denominator", "run_id", "evidence_class", "scientific_authority", "claim_boundary", "record_sha256"],
  "properties": {"schema_version": {"const": "myis.observatory-metric.v1"}, "record_id": {"type": "string"}, "name": {"type": "string"}, "cutoff": {"type": "integer", "minimum": 1}, "direction": {"enum": ["maximize", "minimize"]}, "data_role": {"type": "string"}, "scope": {"type": "string"}, "evidence_role": {"type": "string"}, "value": {"type": "number"}, "n": {"type": "integer", "minimum": 0}, "denominator": {"type": "string"}, "run_id": {"type": "string"}, "evidence_class": {"type": "string"}, "scientific_authority": {"type": "boolean"}, "claim_boundary": {"type": "string"}, "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
