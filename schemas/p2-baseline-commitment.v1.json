{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:p2-baseline-commitment:v1",
  "title": "myIS P2 immutable baseline expectation commitment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "phase_id", "campaign_revision", "budget_profile_id", "budget_profile_sha256", "baseline_candidate_id", "baseline_arm", "prior_artifact_uri", "prior_artifact_sha256", "metric_locator", "expected_metric", "tolerance", "created_before_train_outcomes", "commitment_sha256"],
  "properties": {
    "schema_version": {"const": "myis.p2-baseline-commitment.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "phase_id": {"const": "P2_SCOPE_DEVELOPMENT"},
    "campaign_revision": {"type": "string", "minLength": 1},
    "budget_profile_id": {"type": "string", "pattern": "^p2-r1-primary-v[0-9]+$"},
    "budget_profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "baseline_arm": {"enum": ["R0", "R0-W", "R1"]},
    "prior_artifact_uri": {"type": "string", "minLength": 1},
    "prior_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metric_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics_index"],
      "properties": {
        "metrics_index": {"type": "integer", "minimum": 0}
      }
    },
    "expected_metric": {"$ref": "urn:myis:research:schema:p2-train-metric:v1"},
    "tolerance": {"type": "number", "minimum": 0, "maximum": 1},
    "created_before_train_outcomes": {"const": true},
    "commitment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
