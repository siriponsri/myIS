{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:metric-bundle:v1",
  "title": "myIS aggregate metric bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "metrics", "cost"],
  "properties": {
    "schema_version": {"const": "myis.metric-bundle.v1"},
    "run_id": {"type": "string"},
    "metrics": {"type": "array"},
    "cost": {"type": "object"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}}
  }
}
