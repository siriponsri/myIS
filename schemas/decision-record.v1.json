{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:decision-record:v1",
  "title": "myIS standing decision record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "status", "campaign_id", "evidence_hashes", "prior_record_hash"],
  "properties": {
    "schema_version": {"const": "myis.decision-record.v1"},
    "decision_id": {"enum": ["D1_START_CAMPAIGN", "D2_OPEN_FINAL", "D3_SUBMIT_RELEASE"]},
    "status": {"enum": ["proposed", "approved", "deferred", "rejected", "superseded"]},
    "campaign_id": {"type": "string"},
    "evidence_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "prior_record_hash": {"type": ["string", "null"]},
    "rationale": {"type": "string"},
    "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
