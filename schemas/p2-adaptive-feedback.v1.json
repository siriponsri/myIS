{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:p2-adaptive-feedback:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feedback_id", "request_id", "campaign_revision", "iteration", "lineage_hashes", "aggregate_candidates", "failure_categories", "remaining_axes", "budget_counters", "selection_exposures", "protected_data_accessed", "feedback_sha256"],
  "properties": {
    "schema_version": {"const": "myis.p2-adaptive-feedback.v1"},
    "feedback_id": {"type": "string"},
    "request_id": {"type": "string"},
    "campaign_revision": {"type": "string"},
    "iteration": {"type": "integer", "minimum": 1},
    "lineage_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "aggregate_candidates": {"type": "array", "items": {"type": "object"}},
    "failure_categories": {"type": "array", "items": {"type": "string"}},
    "remaining_axes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "budget_counters": {"type": "object"},
    "selection_exposures": {"const": 0},
    "protected_data_accessed": {"const": false},
    "feedback_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
