{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:p2-proposer-invocation:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "invocation_id", "request_sha256", "execution_source_commit", "contract_sha256", "instructions_sha256", "prompt_sha256", "feedback_sha256", "output_schema_sha256", "provider", "model", "revision", "effort", "tool_version", "seed", "output_sha256", "retry_count", "environment_removed", "protected_data_accessed", "measured_execution_performed", "invocation_sha256"],
  "properties": {
    "schema_version": {"const": "myis.p2-proposer-invocation.v1"},
    "invocation_id": {"type": "string"},
    "request_sha256": {"$ref": "#/$defs/hash"},
    "execution_source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "contract_sha256": {"$ref": "#/$defs/hash"},
    "instructions_sha256": {"$ref": "#/$defs/hash"},
    "prompt_sha256": {"$ref": "#/$defs/hash"},
    "feedback_sha256": {"$ref": "#/$defs/hash"},
    "output_schema_sha256": {"$ref": "#/$defs/hash"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "effort": {"type": "string", "minLength": 1},
    "tool_version": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "output_sha256": {"$ref": "#/$defs/hash"},
    "retry_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "environment_removed": {
      "type": "array",
      "contains": {"const": "MYIS_STORE"},
      "minContains": 1,
      "allOf": [{"contains": {"const": "MYIS_MLFLOW_STORE"}, "minContains": 1}]
    },
    "protected_data_accessed": {"const": false},
    "measured_execution_performed": {"const": false},
    "invocation_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
