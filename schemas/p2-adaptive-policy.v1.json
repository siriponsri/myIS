{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myis:research:schema:p2-adaptive-policy:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "campaign_revision", "status", "candidates_per_iteration", "batch_roles", "allowed_axes", "forbidden_axes", "candidate_id_pattern", "scientific_identity_exclusions", "admission", "stopping", "policy_sha256"],
  "properties": {
    "schema_version": {"const": "myis.p2-adaptive-policy.v1"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "campaign_revision": {"type": "string", "minLength": 1},
    "status": {"const": "adopted_hash_locked"},
    "candidates_per_iteration": {"const": 4},
    "batch_roles": {"const": ["exploit", "matched_ablation", "orthogonal", "diversity"]},
    "allowed_axes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "forbidden_axes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "candidate_id_pattern": {"type": "string", "minLength": 1},
    "scientific_identity_exclusions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "admission": {"type": "object"},
    "stopping": {"type": "object"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
