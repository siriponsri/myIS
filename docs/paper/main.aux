\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Best representation---for whom?} Development Recall@100 for three representation sources and consuming retrievers, on disclosed target-specific values. The nominal best source (amber) changes with the target, but the within-target spread is below 0.004 for every target, while the between-target bands are separated by substantially more than the within-target spreads. Development evidence; no single cell carries confirmatory inference.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:transfer}{{2}{4}{\textbf {Best representation---for whom?} Development Recall@100 for three representation sources and consuming retrievers, on disclosed target-specific values. The nominal best source (amber) changes with the target, but the within-target spread is below 0.004 for every target, while the between-target bands are separated by substantially more than the within-target spreads. Development evidence; no single cell carries confirmatory inference}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Final-872 comparison of two complete frozen configurations.} (a)~Absolute cross-domain Recall@100 and nDCG@100. (b)~Paired selected-minus-comparator differences with 95\% percentile intervals from 10,000 paired bootstrap resamples. (c)~Recall@100 query-level wins, ties, and losses. The comparison supports the complete selected system, not a representation-only causal effect.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:confirmation}{{3}{4}{\textbf {Final-872 comparison of two complete frozen configurations.} (a)~Absolute cross-domain Recall@100 and nDCG@100. (b)~Paired selected-minus-comparator differences with 95\% percentile intervals from 10,000 paired bootstrap resamples. (c)~Recall@100 query-level wins, ties, and losses. The comparison supports the complete selected system, not a representation-only causal effect}{figure.3}{}}
