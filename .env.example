# Never commit real credentials.
# Both stores must be absolute paths outside this Git worktree for measured
# Owner-local execution. Fixture-only tests do not require either variable.
MYIS_STORE=C:/path/to/My_Research/01_Stores/00_myIS/raw
MYIS_MLFLOW_STORE=C:/path/to/My_Research/01_Stores/00_myIS/mlflow
MLFLOW_TRACKING_URI=sqlite:///C:/path/to/My_Research/01_Stores/00_myIS/mlflow/database/mlflow.db
MLFLOW_ARTIFACT_ROOT=C:/path/to/My_Research/01_Stores/00_myIS/mlflow/artifacts

# Future/local model service only; not used by deterministic P2 R1.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=<owner-local-only>
